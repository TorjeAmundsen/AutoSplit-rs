// Make Split Images: a preset's masks applied to screenshots, saved as split images named the way
// AutoSplit reads them, into the split image folder. Edit switches it to editing the preset, with
// the selected split's mask shown on the capture as it's changed.

import { CheckBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Button, ComboBox, FileName, Label, NamePart, Preview, SavedCheck, SpinBox, TextField, Theme, Tip } from "widgets.slint";

// A split of the preset, with the file name it gets and where its screenshot comes from.
export struct MakerRow {
    // The split's name
    heading: string,
    parts: [NamePart],
    file: string,
    // The screenshot's file name, or empty
    source: string,
    // The split image is written
    saved: bool,
    // A small picture of its split image, once there's something to make it from
    thumb: image,
    has-thumb: bool,
    // Something has to be fixed before the preset can be saved
    problem: bool,
    // Compared for the same split as the row above
    joined: bool,
    // Every other split, or group of splits compared together, is shaded
    shaded: bool,
}

// What the form shows of the selected split besides its fields, while editing.
// A field of the split form, which says it was edited. Its value is in its property.
export enum SplitField { name, kind, threshold, delay, pause, dummy, below, with-previous, instructions }

export struct SplitForm {
    // What has to be fixed in each field, one problem a line, or empty
    name-problem: string,
    mask-problem: string,
    group-problem: string,
    mask: string,
    savestate: string,
    // Full paths, for the tooltips
    mask-path: string,
    savestate-path: string,
    // Picked from outside the preset's folder, so saving copies it in
    mask-copied: bool,
    savestate-copied: bool,
    // Compared together with others, or a second reset or start image, which the profile has
    // turned off
    grouping-off: bool,
    // There's a split above that it can be compared with
    can-join: bool,
    // Why not, for the greyed out checkbox's tooltip
    why-not-joined: string,
}

// A field's problems under it, lined up with the field and wrapped so all of them show. Also a
// note about the field, in another color.
component FieldProblem inherits HorizontalLayout {
    in property <length> label-width;
    in property <string> text;
    in property <color> color: Theme.error;
    spacing: 6px;

    Rectangle {
        width: root.label-width;
    }

    Text {
        color: root.color;
        text: root.text;
        wrap: word-wrap;
    }
}

export component MakerWindow inherits Window {
    title: "Make Split Images";
    icon: @image-url("../assets/icon.png");
    default-font-size: 12px;

    in property <[string]> games;
    in-out property <int> game-index;
    // The chosen game's presets
    in property <[string]> presets;
    in-out property <int> preset-index;
    in property <[MakerRow]> rows;
    in-out property <int> selected: 0;
    // Shown from its end when it's too long, since the end tells folders apart. Empty for none
    in property <string> output-folder;
    in property <image> live-image;
    in property <string> live-message: "Waiting for capture device...";
    in property <bool> can-grab;
    in property <image> preview-image;
    in property <string> preview-message: "No screenshot for this split yet.";
    // Behind the split image, so its transparent parts show
    in property <image> grid-image;
    in-out property <bool> show-grid: true;
    property <image> no-image;
    in property <string> status;
    in property <bool> can-save-selected;
    in property <bool> can-save-all;
    in property <bool> can-test;
    in property <bool> has-savestates;
    in property <bool> has-instructions;
    // The preset compares several images for one split, which the profile doesn't do
    in property <bool> needs-grouping;
    // What has to be fixed in the chosen preset before anything's made from it, or empty
    in property <string> preset-problem;
    // A message box is open, which AutoSplit's are modal
    in property <bool> blocked;

    // Editing the preset instead of making its split images
    in property <bool> editing;
    // Split images are being saved or the list's pictures made, which editing waits for
    in property <bool> working;
    // The preset's game and name while editing, set when editing starts
    in-out property <string> edit-game;
    in-out property <string> edit-name;
    // The selected split's fields, set when another split is selected and kept by the fields
    // while they're edited
    in property <SplitForm> form;
    in-out property <string> split-name;
    // What the split is: 0 a split, 1 the start image, 2 a reset image, from kinds
    in-out property <int> split-kind;
    in property <[string]> kinds;
    in-out property <float> threshold;
    // Milliseconds
    in-out property <float> delay;
    in-out property <bool> has-pause;
    // Seconds
    in-out property <float> pause;
    in-out property <bool> dummy;
    in-out property <bool> below;
    in-out property <bool> with-previous;
    in-out property <string> instructions;
    // Changes when the form is filled with a split, so number fields drop what was typed for the
    // split before
    in property <int> form-generation;
    // Whether a split is selected to edit
    in property <bool> has-split;
    // What has to be fixed before saving, or that it's ready
    in property <string> problems;
    // Every problem on a line of its own, with the split it's about
    in property <string> problem-list;
    // The split the problem line goes to when clicked: the next one with a problem, or -1
    in property <int> problem-split: -1;
    in property <bool> has-problems;
    in property <bool> can-save-preset;
    // The preset is saved already, so there's a folder to delete
    in property <bool> can-delete-preset;

    callback game-chosen(int);
    // The index among the game's presets
    callback preset-chosen(int);
    callback split-chosen(int);
    callback edit-preset();
    callback new-preset();
    callback game-edited(string);
    callback name-edited(string);
    callback split-edited(SplitField);
    callback choose-mask();
    callback choose-savestate();
    callback clear-savestate();
    callback add-split();
    callback duplicate-split();
    callback remove-split();
    callback move-split(bool);
    callback save-preset();
    callback save-preset-as-new();
    callback cancel-edit();
    callback show-problems();
    callback delete-preset();
    callback turn-on-grouping();

    // The split list's rows: the split's name over its file name, beside a picture
    property <length> row-height: 44px;
    // The form's labels, so the fields line up
    property <length> label-width: 66px;

    // Selects split `index`, scrolled into view
    public function pick(index: int) {
        root.selected = index;
        if (index * root.row-height < -list.content-y) {
            list.content-y = -index * root.row-height;
        }
        if ((index + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * root.row-height - list.visible-height);
        }
        root.split-chosen(index);
    }
    callback grab();
    callback use-screenshots();
    callback save-selected();
    callback save-all();
    callback test();
    callback copy-savestates();
    callback show-instructions();
    callback browse-folder();

    property <bool> saved-flash;

    // Split images were saved: the output preview dims under a check mark for a moment
    public function split-images-saved() {
        root.saved-flash = true;
        // Restarting only resets a running timer, it doesn't start a stopped one
        flash-timer.running = true;
        flash-timer.restart();
    }

    flash-timer := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.running = false;
            root.saved-flash = false;
        }
    }
    callback generate-profile();
    callback blocked-clicked();

    // Two columns whose rows line up: the splits beside the previews, the list as tall as both
    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                width: 480px;
                spacing: 6px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Label {
                        width: 46px;
                        text: "Game:";
                    }

                    if !root.editing: ComboBox {
                        model: root.games;
                        current-index <=> root.game-index;
                        selected => { root.game-chosen(root.game-index); }
                    }

                    if root.editing: TextField {
                        text <=> root.edit-game;
                        placeholder-text: "The game, which presets are listed under";
                        edited(text) => { root.game-edited(text); }
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Label {
                        width: 46px;
                        text: "Preset:";
                    }

                    if !root.editing: ComboBox {
                        model: root.presets;
                        current-index <=> root.preset-index;
                        selected => { root.preset-chosen(root.preset-index); }
                    }

                    if !root.editing: Button {
                        width: 60px;
                        height: 24px;
                        text: "Edit";
                        enabled: root.presets.length > 0 && !root.working;
                        clicked => { root.edit-preset(); }

                        Tooltip {
                            Tip {
                                text: "Change this preset's splits, masks and settings";
                            }
                        }
                    }

                    if !root.editing: Button {
                        width: 60px;
                        height: 24px;
                        text: "New";
                        enabled: !root.working;
                        clicked => { root.new-preset(); }

                        Tooltip {
                            Tip {
                                text: "Make a new preset for this game";
                            }
                        }
                    }

                    if root.editing: TextField {
                        text <=> root.edit-name;
                        placeholder-text: "The preset's name, like the category";
                        edited(text) => { root.name-edited(text); }
                    }
                }

                Label {
                    height: 20px;
                    text: "Splits";
                }

                // The outline is outside, like the previews', so their edges line up
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.field;

                    Rectangle {
                        x: -1px;
                        y: -1px;
                        width: parent.width + 2px;
                        height: parent.height + 2px;
                        border-width: 1px;
                        border-color: Theme.frame;
                    }

                    // Up and Down pick the split above or below, scrolled into view
                    list-keys := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow && root.selected > 0) {
                                root.pick(root.selected - 1);
                                return accept;
                            }
                            if (event.text == Key.DownArrow && root.selected < root.rows.length - 1) {
                                root.pick(root.selected + 1);
                                return accept;
                            }
                            reject
                        }

                        list := ScrollView {
                            content-height: root.rows.length * root.row-height;

                            for row[index] in root.rows: row-box := Rectangle {
                                y: index * root.row-height;
                                height: root.row-height;
                                width: parent.width;
                                background: index == root.selected ? Theme.selection.with-alpha(list-keys.has-focus ? 0.35 : 0.2) : row.shaded ? Theme.stripe : transparent;

                                TouchArea {
                                    clicked => {
                                        list-keys.focus();
                                        root.pick(index);
                                    }
                                }

                                // Splits compared together are one block: a line only above the
                                // first, and a bar down the margin beside all of them
                                property <bool> joins-next: index + 1 < root.rows.length && root.rows[index + 1].joined;

                                if index > 0 && !row.joined: Rectangle {
                                    y: 0px;
                                    height: 1px;
                                    background: Theme.separator;
                                }

                                if row.joined || row-box.joins-next: Rectangle {
                                    x: 4px;
                                    y: row.joined ? 0px : 5px;
                                    width: 3px;
                                    height: root.row-height - self.y - (row-box.joins-next ? 0px : 5px);
                                    background: Theme.secondary-text;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    // Clear of the scroll bar, 14px wide over the rows when it shows
                                    padding-right: root.rows.length * root.row-height > list.visible-height ? 20px : 6px;
                                    spacing: 8px;

                                    // The split image at a glance, or an empty box until there's
                                    // something to make it from
                                    VerticalLayout {
                                        alignment: center;

                                        Rectangle {
                                            width: 48px;
                                            height: 36px;
                                            border-width: 1px;
                                            border-color: Theme.frame;

                                            if row.has-thumb: Image {
                                                x: 1px;
                                                y: 1px;
                                                width: parent.width - 2px;
                                                height: parent.height - 2px;
                                                source: row.thumb;
                                                image-fit: fill;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Label {
                                            height: 18px;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: row.problem ? Theme.error : Theme.text;
                                            text: row.heading;
                                        }

                                        Rectangle {
                                            height: 16px;
                                            clip: true;

                                            FileName {
                                                parts: row.parts;
                                                file: row.file;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        Label {
                                            height: 16px;
                                            horizontal-alignment: right;
                                            color: Theme.secondary-text;
                                            text: row.source;
                                        }

                                        Label {
                                            height: 16px;
                                            horizontal-alignment: right;
                                            color: Theme.reached;
                                            text: row.saved ? "saved" : "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Where split images come from, then what's done with them, out to the list's edges
                if !root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Button {
                        width: 90px;
                        height: 24px;
                        text: "Grab";
                        primary: true;
                        enabled: root.can-grab;
                        clicked => { root.grab(); }

                        Tooltip {
                            Tip {
                                text: "Make the selected split's image from the capture now, save it into the split image folder, and go to the next split. The screenshot hotkey does the same while this window is open.";
                            }
                        }
                    }

                    Button {
                        width: 120px;
                        height: 24px;
                        text: "Use Screenshots...";
                        enabled: root.preset-problem == "";
                        clicked => { root.use-screenshots(); }

                        Tooltip {
                            Tip {
                                text: "Make split images from screenshot files instead: one for the selected split, or several for the splits in order from the first";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        width: 60px;
                        height: 24px;
                        text: "Test";
                        enabled: root.can-test;
                        clicked => { root.test(); }

                        Tooltip {
                            Tip {
                                text: "Open the selected split's saved split image in the Live Tester";
                            }
                        }
                    }

                    Button {
                        width: 100px;
                        height: 24px;
                        text: "Save Selected";
                        enabled: root.can-save-selected;
                        clicked => { root.save-selected(); }
                    }

                    Button {
                        width: 80px;
                        height: 24px;
                        text: "Save All";
                        enabled: root.can-save-all;
                        clicked => { root.save-all(); }
                    }
                }

                // The splits' order, out to the list's edges like the buttons they replace
                if root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Button {
                        width: 70px;
                        height: 24px;
                        text: "Add";
                        clicked => { root.add-split(); }

                        Tooltip {
                            Tip {
                                text: "Add a split after the selected one";
                            }
                        }
                    }

                    Button {
                        width: 80px;
                        height: 24px;
                        text: "Duplicate";
                        enabled: root.has-split;
                        clicked => { root.duplicate-split(); }

                        Tooltip {
                            Tip {
                                text: "Add a copy of the selected split after it, with the same mask";
                            }
                        }
                    }

                    Button {
                        width: 70px;
                        height: 24px;
                        text: "Remove";
                        enabled: root.has-split;
                        clicked => { root.remove-split(); }

                        Tooltip {
                            Tip {
                                text: "Remove the selected split. Ctrl+Z brings it back, with its grab or screenshot.";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        width: 80px;
                        height: 24px;
                        text: "Move Up";
                        enabled: root.has-split && root.selected > 0;
                        clicked => { root.move-split(true); }
                    }

                    Button {
                        width: 80px;
                        height: 24px;
                        text: "Move Down";
                        enabled: root.has-split && root.selected < root.rows.length - 1;
                        clicked => { root.move-split(false); }
                    }
                }
            }

            VerticalLayout {
                width: 320px;
                spacing: 6px;

                if !root.editing: Label {
                    height: 24px;
                    text: "Saves to the split image folder:";
                }

                if !root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    // Like a read-only field, without a cursor; the whole path in its tooltip
                    Rectangle {
                        background: Theme.field;
                        border-width: 1px;
                        border-radius: 2px;
                        border-color: Theme.outline;

                        Rectangle {
                            x: 6px;
                            width: parent.width - 12px;
                            clip: true;

                            // Short, so none of it is cut off
                            if root.output-folder == "": Text {
                                x: 0px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.secondary-text;
                                text: "None yet. Use Browse...";
                            }

                            // Too long, it's moved left so its end shows, measured as it's drawn
                            folder-text := Text {
                                x: min(0px, parent.width - self.preferred-width);
                                width: self.preferred-width;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.text;
                                text: root.output-folder;
                            }

                            // Covers the cut start
                            if folder-text.preferred-width > parent.width: Rectangle {
                                x: 0px;
                                width: 16px;
                                background: Theme.field;

                                Text {
                                    x: 0px;
                                    vertical-alignment: center;
                                    color: Theme.text;
                                    text: "...";
                                }
                            }
                        }

                        Tooltip {
                            Tip {
                                text: root.output-folder == "" ? "No split image folder yet. Pick one with Browse..., where the split images are saved." : root.output-folder;
                            }
                        }
                    }

                    Button {
                        width: 70px;
                        height: 24px;
                        text: "Browse...";
                        clicked => { root.browse-folder(); }
                    }
                }

                if !root.editing: Label {
                    height: 20px;
                    text: "Capture Region";
                }

                if !root.editing: Preview {
                    height: 240px;
                    source: root.live-image;
                    message: root.live-message;
                }

                // The selected split, in the space of the folder and the capture, which the
                // output preview below shows masked as it's edited
                if root.editing: VerticalLayout {
                    height: 326px;
                    spacing: 6px;

                    if !root.has-split: Label {
                        vertical-stretch: 1;
                        horizontal-alignment: center;
                        color: Theme.secondary-text;
                        text: "Add a split to edit it.";
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        Label {
                            width: root.label-width;
                            text: "Type:";
                        }

                        ComboBox {
                            width: 140px;
                            model: root.kinds;
                            current-index <=> root.split-kind;
                            selected => { root.split-edited(SplitField.kind); }

                            Tooltip {
                                Tip {
                                    text: "A split, or the image that starts the timer or resets the run. AutoSplit reads it from the name, start_auto_splitter or reset, which this sets.";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        Label {
                            width: root.label-width;
                            text: "Name:";
                        }

                        // A start or reset image's name is what makes it one
                        TextField {
                            error: root.form.name-problem != "";
                            enabled: root.split-kind == 0;
                            text <=> root.split-name;
                            edited => { root.split-edited(SplitField.name); }
                        }
                    }

                    if root.has-split && root.form.name-problem != "": FieldProblem {
                        label-width: root.label-width;
                        text: root.form.name-problem;
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        Label {
                            width: root.label-width;
                            text: "Mask:";
                        }

                        Label {
                            horizontal-stretch: 1;
                            color: root.form.mask-problem != "" ? Theme.error : root.form.mask == "" ? Theme.secondary-text : Theme.text;
                            text: root.form.mask-problem != "" ? root.form.mask-problem : root.form.mask == "" ? "None yet" : root.form.mask;

                            Tooltip {
                                Tip {
                                    text: "The part of the screen that's compared: where the mask is opaque. The output preview shows it on the capture." + (root.form.mask-path == "" ? "" : "\n\n" + root.form.mask-path) + (root.form.mask-copied ? "\n\nSaving copies it into the preset's folder." : "");
                                }
                            }
                        }

                        Button {
                            width: 80px;
                            height: 24px;
                            text: "Choose...";
                            primary: root.form.mask == "";
                            clicked => { root.choose-mask(); }
                        }
                    }

                    if root.has-split && root.form.mask-copied: FieldProblem {
                        label-width: root.label-width;
                        color: Theme.secondary-text;
                        text: "Saving copies it into the preset's folder.";
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        Label {
                            width: root.label-width;
                            text: "Threshold:";
                        }

                        SpinBox {
                            width: 64px;
                            height: 22px;
                            minimum: 0;
                            maximum: 1;
                            step: 0.01;
                            decimals: 2;
                            generation: root.form-generation;
                            value <=> root.threshold;
                            edited => { root.split-edited(SplitField.threshold); }
                        }

                        Label {
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            text: "Delay:";

                            Tooltip {
                                Tip {
                                    text: "How long to wait after the image matches before splitting";
                                }
                            }
                        }

                        SpinBox {
                            width: 74px;
                            height: 22px;
                            minimum: 0;
                            maximum: 600000;
                            step: 100;
                            generation: root.form-generation;
                            value <=> root.delay;
                            edited => { root.split-edited(SplitField.delay); }
                        }

                        Label {
                            width: 20px;
                            text: "ms";
                        }
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        CheckBox {
                            width: root.label-width;
                            text: "Pause";
                            checked <=> root.has-pause;
                            toggled => { root.split-edited(SplitField.pause); }

                            Tooltip {
                                Tip {
                                    text: "How long to stop comparing after the split. Unchecked uses the profile's default pause time.";
                                }
                            }
                        }

                        SpinBox {
                            width: 64px;
                            height: 22px;
                            minimum: 0;
                            maximum: 3600;
                            step: 0.5;
                            decimals: 2;
                            enabled: root.has-pause;
                            generation: root.form-generation;
                            value <=> root.pause;
                            edited => { root.split-edited(SplitField.pause); }
                        }

                        Label {
                            color: root.has-pause ? Theme.text : Theme.secondary-text;
                            text: root.has-pause ? "seconds" : "the profile's default";
                        }
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 12px;

                        Rectangle {
                            width: root.label-width - 6px;
                        }

                        CheckBox {
                            text: "Dummy";
                            checked <=> root.dummy;
                            toggled => { root.split-edited(SplitField.dummy); }

                            Tooltip {
                                Tip {
                                    text: "Matching it moves on to the next image without splitting, for screens that come before the real split";
                                }
                            }
                        }

                        CheckBox {
                            text: "Split below threshold";
                            checked <=> root.below;
                            toggled => { root.split-edited(SplitField.below); }

                            Tooltip {
                                Tip {
                                    text: "Split when the similarity drops back below the threshold after reaching it, like when a screen goes away";
                                }
                            }
                        }
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 12px;

                        Rectangle {
                            width: root.label-width - 6px;
                        }

                        CheckBox {
                            text: "Same split as the one above";
                            enabled: root.form.can-join || root.with-previous;
                            checked <=> root.with-previous;
                            toggled => { root.split-edited(SplitField.with-previous); }

                            Tooltip {
                                Tip {
                                    text: (root.form.why-not-joined == "" ? "" : root.form.why-not-joined + "\n\n") + "Compare it for the same split as the split above, so either one matching splits, like a boss that dies in one of two rooms. They get the same number. Up to 4 splits together. Needs Compare images with the same number for one split, in Settings.";
                                }
                            }
                        }
                    }

                    if root.has-split && root.form.group-problem != "": FieldProblem {
                        label-width: root.label-width;
                        text: root.form.group-problem;
                    }

                    if root.has-split && root.form.group-problem == "" && root.form.grouping-off: FieldProblem {
                        label-width: root.label-width;
                        color: Theme.secondary-text;
                        text: "The profile has comparing several images for one split turned off. Generate Profile..., or Turn It On after saving, turns it on.";
                    }

                    if root.has-split: HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        Label {
                            width: root.label-width;
                            text: "Savestate:";
                        }

                        Label {
                            horizontal-stretch: 1;
                            color: root.form.savestate == "" ? Theme.secondary-text : Theme.text;
                            text: root.form.savestate == "" ? "None" : root.form.savestate;

                            Tooltip {
                                Tip {
                                    text: "A savestate at the split's screen, for taking its screenshot, made with a practice tool that loads savestates on the console, like gz for Ocarina of Time (.gzs). Copy Savestates puts them on the clipboard." + (root.form.savestate-path == "" ? "" : "\n\n" + root.form.savestate-path) + (root.form.savestate-copied ? "\n\nSaving copies it into the preset's savestates folder." : "");
                                }
                            }
                        }

                        Button {
                            width: 80px;
                            height: 24px;
                            text: "Choose...";
                            clicked => { root.choose-savestate(); }
                        }

                        Button {
                            width: 50px;
                            height: 24px;
                            text: "Clear";
                            enabled: root.form.savestate != "";
                            clicked => { root.clear-savestate(); }
                        }
                    }

                    if root.has-split && root.form.savestate-copied: FieldProblem {
                        label-width: root.label-width;
                        color: Theme.secondary-text;
                        text: "Saving copies it into the preset's savestates folder.";
                    }

                    if root.has-split: TextEdit {
                        vertical-stretch: 1;
                        font-size: 12px;
                        wrap: word-wrap;
                        enabled: root.form.savestate != "";
                        placeholder-text: root.form.savestate == "" ? "Instructions for the savestate, once there is one" : "What to do after loading the savestate, if anything";
                        text <=> root.instructions;
                        edited => { root.split-edited(SplitField.instructions); }
                    }
                }

                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;

                    Label {
                        horizontal-stretch: 1;
                        text: root.editing ? "Output Preview, with the mask" : "Output Preview";
                    }

                    CheckBox {
                        width: 130px;
                        text: "Transparency grid";
                        checked <=> root.show-grid;
                    }
                }

                Preview {
                    height: 240px;
                    source: root.preview-image;
                    message: root.preview-message;
                    backdrop: root.show-grid ? root.grid-image : root.no-image;

                    TouchArea {
                        clicked => { root.show-grid = !root.show-grid; }
                    }

                    SavedCheck {
                        shown: root.saved-flash;
                    }
                }

                if !root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Button {
                        height: 24px;
                        text: "Copy Savestates";
                        enabled: root.has-savestates;
                        clicked => { root.copy-savestates(); }

                        Tooltip {
                            Tip {
                                text: "Put the preset's savestates on the clipboard, numbered like the split images, to paste where the practice tool on the console loads them from, like gz's savestate folder on the SD card";
                            }
                        }
                    }

                    Button {
                        height: 24px;
                        text: "Savestate Instructions";
                        enabled: root.has-instructions;
                        clicked => { root.show-instructions(); }
                    }
                }

                if root.editing: HorizontalLayout {
                    height: 24px;
                    alignment: end;

                    Button {
                        width: 110px;
                        height: 24px;
                        text: "Delete Preset...";
                        enabled: root.can-delete-preset;
                        clicked => { root.delete-preset(); }

                        Tooltip {
                            Tip {
                                text: "Delete this preset's folder, with its masks and savestates";
                            }
                        }
                    }
                }
            }
        }

        if !root.editing: HorizontalLayout {
            height: 24px;
            spacing: 6px;

            if root.preset-problem == "" && !root.needs-grouping: Label {
                horizontal-stretch: 1;
                text: root.status;
            }

            if root.preset-problem != "": Label {
                horizontal-stretch: 1;
                color: Theme.error;
                text: root.preset-problem;

                Tooltip {
                    Tip {
                        text: "The preset has to be fixed before split images are made or savestates copied from it. " + root.preset-problem;
                    }
                }
            }

            if root.preset-problem != "": Button {
                width: 80px;
                height: 24px;
                text: "Fix It";
                enabled: !root.working;
                clicked => { root.edit-preset(); }
            }

            if root.preset-problem == "" && root.needs-grouping: Label {
                horizontal-stretch: 1;
                color: Theme.error;
                text: "This preset compares several images for one split, which the profile has turned off.";

                Tooltip {
                    Tip {
                        text: "Some splits are compared together, or there are several reset or start images. The split image folder only loads like that with Compare images with the same number for one split turned on in Settings.";
                    }
                }
            }

            if root.preset-problem == "" && root.needs-grouping: Button {
                width: 80px;
                height: 24px;
                text: "Turn It On";
                clicked => { root.turn-on-grouping(); }
            }

            Button {
                width: 130px;
                height: 24px;
                text: "Generate Profile...";
                enabled: root.presets.length > 0 && root.preset-problem == "";
                clicked => { root.generate-profile(); }

                Tooltip {
                    Tip {
                        text: "Save the settings as a new profile named for the game and preset, with this split image folder, and use it from now on";
                    }
                }
            }
        }

        if root.editing: HorizontalLayout {
            height: 24px;
            spacing: 6px;

            // Hovering shows every problem, clicking lists them in a message box
            if root.has-problems: VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.error;

                    Text {
                        text: "!";
                        color: white;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.show-problems(); }
                    }

                    Tooltip {
                        Tip {
                            text: root.problem-list;
                        }
                    }
                }
            }

            Label {
                horizontal-stretch: 1;
                color: root.has-problems ? Theme.error : Theme.secondary-text;
                text: root.problems;

                // Goes to the split with the problem, then the next one each click
                TouchArea {
                    enabled: root.problem-split >= 0;
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        // Like clicking the list: a field being typed in commits first
                        list-keys.focus();
                        root.pick(root.problem-split);
                    }
                }

                Tooltip {
                    Tip {
                        text: root.problem-list;
                    }
                }
            }

            Button {
                width: 110px;
                height: 24px;
                text: "Save as New";
                enabled: !root.has-problems;
                clicked => { root.save-preset-as-new(); }

                Tooltip {
                    Tip {
                        text: "Save these changes as a new preset, and leave this one as it was";
                    }
                }
            }

            Button {
                width: 70px;
                height: 24px;
                text: "Cancel";
                clicked => { root.cancel-edit(); }
            }

            Button {
                width: 70px;
                height: 24px;
                text: "Save";
                primary: true;
                enabled: root.can-save-preset;
                clicked => { root.save-preset(); }
            }
        }
    }

    if root.blocked: TouchArea {
        clicked => { root.blocked-clicked(); }
    }
}
