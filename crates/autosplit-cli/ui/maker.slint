// Make Split Images: a preset's masks applied to screenshots, saved as split images named the way
// AutoSplit reads them, into the split image folder. Edit switches it to editing the preset, with
// the selected split's mask shown on the capture as it's changed.

import { CheckBox, ScrollView } from "std-widgets.slint";
import { Button, ClickAway, ComboBox, FileName, GridIcon, IconButton, Icons, IconToggle, Keys, Label, LiveIcon, MaskIcon, NamePart, OpenList, Preview, SavedCheck, SavedGlow, TextField, Theme, Tip } from "widgets.slint";
import { InlineMessage, MessageOverlay } from "message.slint";
import { SplitField, SplitForm, SplitFormPanel, SplitValues } from "split_form.slint";

export { SplitField, SplitForm, SplitValues }

// A split of the preset, with the file name it gets and where its screenshot comes from.
export struct MakerRow {
    // The split's name
    heading: string,
    parts: [NamePart],
    file: string,
    // The screenshot's file name, or empty
    source: string,
    // The split image is written
    saved: bool,
    // A small picture of its split image, once there's something to make it from
    thumb: image,
    has-thumb: bool,
    // Something has to be fixed before the preset can be saved
    problem: bool,
    // Compared for the same split as the row above
    joined: bool,
    // Every other split, or group of splits compared together, is shaded
    shaded: bool,
    // The runner can turn it on or off, with a checkbox
    toggleable: bool,
    // Turned off, by the preset or the runner, so it gets no split image
    off: bool,
    // Why the runner can't turn it on or off, for the tooltip where its checkbox would be
    fixed: string,
    // Off, with an image in the split image folder, which AutoSplit still compares
    kept: bool,
    // Off and not being chosen, so it isn't shown
    hidden: bool,
    // Its place among the shown rows, from 0
    place: int,
    // The shown rows above and below it, for Up and Down, or -1 for none
    above: int,
    below: int,
    // The runner can't turn it off, which choosing says where a checkbox would be
    always-on: bool,
    // The split whose checkbox turns it on or off, or -1 when it's always on
    leader: int,
    // For a split with a checkbox: the place of the first of the splits compared together with
    // it, and how many they are, which the checkbox is centered on
    box-top: int,
    box-rows: int,
}

// The split image folder, like a read-only field without a cursor, with the whole path in its
// tooltip, and Browse... beside it.
component FolderPicker inherits HorizontalLayout {
    // Shown from its end when it's too long, since the end tells folders apart. Empty for none
    in property <string> folder;
    // Browse... is a folder icon
    in property <bool> icon-only;
    callback browse();

    height: 24px;
    spacing: 6px;

    Rectangle {
        background: Theme.field;
        border-width: 1px;
        border-radius: 2px;
        border-color: Theme.outline;

        Rectangle {
            x: 6px;
            width: parent.width - 12px;
            clip: true;

            // Short, so none of it is cut off
            if root.folder == "": Text {
                x: 0px;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.secondary-text;
                text: root.icon-only ? "None yet. Pick one with the folder button." : "None yet. Use Browse...";
            }

            // Too long, it's moved left so its end shows, measured as it's drawn
            folder-text := Text {
                x: min(0px, parent.width - self.preferred-width);
                width: self.preferred-width;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                text: root.folder;
            }

            // Covers the cut start
            if folder-text.preferred-width > parent.width: Rectangle {
                x: 0px;
                width: 16px;
                background: Theme.field;

                Text {
                    x: 0px;
                    vertical-alignment: center;
                    color: Theme.text;
                    text: "...";
                }
            }
        }

        Tooltip {
            Tip {
                text: root.folder == "" ? "No split image folder yet. Pick one with " + (root.icon-only ? "the folder button" : "Browse...") + ", where the split images are saved." : root.folder;
            }
        }
    }

    if !root.icon-only: Button {
        width: 70px;
        text: "Browse...";
        clicked => { root.browse(); }
        tip: "Pick the split image folder, which the profile uses from now on";
    }

    if root.icon-only: IconButton {
        // What the messages call it
        label: "Folder";
        icon: Icons.folder;
        clicked => { root.browse(); }
        tip: "Pick the split image folder, which the profile uses from now on";
    }
}

export component MakerWindow inherits Window {
    // While editing, the preset's name too, with a * while it has unsaved changes
    title: !root.editing ? "Make Split Images" : (root.edit-changed ? "*" : "") + "Editing " + (root.edit-name == "" ? "a new preset" : root.edit-name) + " - Make Split Images";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Noto Sans";
    default-font-size: 12px;

    in property <[string]> games;
    // A dropdown's list is showing, which Escape closes first
    out property <bool> list-showing: OpenList.showing;
    in-out property <int> game-index;
    // The chosen game's presets
    in property <[string]> presets;
    in-out property <int> preset-index;
    in property <[MakerRow]> rows;
    // The preset has splits the runner can turn on or off, which get checkboxes when not editing
    in property <bool> has-choices;
    // The strip under the list says how many are off, with Choose Splits, which shows every split
    // with checkboxes until Done
    property <bool> show-strip: root.has-choices && !root.editing;
    in property <bool> choosing-splits;
    property <bool> choosing: root.show-strip && root.choosing-splits;
    // Like 2 splits off
    in property <string> choice-summary;
    // A split that's off still has its image in the split image folder, which AutoSplit compares
    in property <bool> choice-kept;
    property <length> strip-height: 30px;
    // How many rows are shown, the ones that aren't hidden
    in property <int> shown-rows;
    // The split whose checkbox the pointer is over while choosing, or -1
    property <int> hovered-leader: -1;
    property <length> box-size: 20px;
    in-out property <int> selected: 0;
    // Shown from its end when it's too long, since the end tells folders apart. Empty for none
    in property <string> output-folder;
    // Shows the file names and every button. Off, the split image folder goes above the list
    // and only what making split images needs shows. Editing always shows everything.
    in property <bool> advanced;
    property <bool> details: root.advanced || root.editing;
    in property <image> live-image;
    in property <string> live-message: "Waiting for capture device...";
    in property <bool> can-grab;
    // Why Grab can't be used yet, like without a capture device, or empty
    in property <string> grab-blocker;
    // The selected split is a fade split, which Grab saves from its color instead of the capture
    in property <bool> grab-fade;
    in property <image> preview-image;
    in property <string> preview-message: "No screenshot for this split yet.";
    // Behind the split image, so its transparent parts show
    in property <image> grid-image;
    in-out property <bool> show-grid: true;
    // While editing, whether the Output Preview applies the mask, and whether it shows the live
    // capture instead of the split's grab or screenshot
    in-out property <bool> preview-mask: true;
    in-out property <bool> preview-live: true;
    callback preview-toggled();
    property <image> no-image;
    in property <string> status;
    in property <bool> can-save-selected;
    in property <bool> can-save-all;
    // Grab is the next step for the selected split. Off when its preset has a screenshot for
    // it, where Save All is
    in property <bool> grab-suggested: true;
    // The selected split has a grab or picked file over its preset's screenshot
    in property <bool> over-preset-screenshot;
    callback use-preset-screenshot();
    in property <bool> can-test;
    in property <bool> has-savestates;
    in property <bool> has-instructions;
    // The preset compares several images for one split, which the profile doesn't do
    in property <bool> needs-grouping;
    // What has to be fixed in the chosen preset before anything's made from it, or empty
    in property <string> preset-problem;
    // A message box is open, which AutoSplit's are modal
    in property <bool> blocked;
    // Screenshots are being recorded, which the bottom line says in red
    in property <bool> recording;
    // What the bottom line says of a recording once it stopped: that its frames are being
    // written, then how many were, for a few seconds
    property <string> recording-note;

    public function recording-writing() {
        root.recording-note = "Writing the recorded screenshots...";
        recording-note-timer.running = false;
    }

    public function recording-done(text: string) {
        root.recording-note = text;
        // Restarting only resets a running timer, it doesn't start a stopped one
        recording-note-timer.running = true;
        recording-note-timer.restart();
    }

    recording-note-timer := Timer {
        interval: 8s;
        running: false;
        triggered => {
            self.running = false;
            root.recording-note = "";
        }
    }
    // A message box drawn in the window, under Wayland, instead of the message window
    in property <InlineMessage> inline-message;
    // Its button, or -1 for closing it
    callback inline-answered(int);

    // Editing the preset instead of making its split images
    in property <bool> editing;
    // Split images are being saved or the list's pictures made, which editing waits for
    in property <bool> working;
    // The preset's game and name while editing, set when editing starts
    in-out property <string> edit-game;
    // While editing: the games to pick from, then New game..., the one picked, and whether a new
    // game is typed instead
    in property <[string]> edit-games;
    in-out property <int> edit-game-index;
    in-out property <bool> new-game;
    in-out property <string> edit-name;
    // What the form shows of the selected split besides its values, which are in SplitValues
    in property <SplitForm> form;
    // The Type list: a split, the start image, a reset image, in SplitKind::ALL's order
    in property <[string]> kinds;
    // The Compare list: the comparison methods, then a fade, in CompareBy::ALL's order
    in property <[string]> compares;
    // Whether a split is selected to edit
    in property <bool> has-split;
    // What has to be fixed before saving, or that it's ready
    in property <string> problems;
    // Every problem on a line of its own, with the split it's about
    in property <string> problem-list;
    // The split the problem line goes to when clicked: the next one with a problem, or -1
    in property <int> problem-split: -1;
    in property <bool> has-problems;
    in property <bool> can-save-preset;
    // The preset being edited differs from how it was opened
    in property <bool> edit-changed;
    // Raised to move the focus to the Name field, like after Add
    in property <int> name-focus-request;
    // Where a split from Split Library would go, as the gap before that row, or -1
    in property <int> drop-line: -1;
    // The preset is saved already, so there's a folder to delete
    // The preset being edited was saved before, so it can be deleted or saved as another
    in property <bool> saved-preset;

    callback game-chosen(int);
    // The index among the game's presets
    callback preset-chosen(int);
    callback split-chosen(int);
    // The checkbox of split `index` was clicked, to turn it and the splits that follow it on or off
    callback split-toggled(int);
    // Choose Splits or Done in the strip under the list
    callback choose-splits();
    callback edit-preset();
    callback new-preset();
    callback import-preset();
    callback export-preset();
    callback game-edited(string);
    callback edit-game-chosen(int);
    callback pick-game();
    callback name-edited(string);
    callback split-edited(SplitField);
    callback choose-mask();
    callback choose-savestate();
    callback clear-savestate();
    callback clear-mask();
    callback choose-screenshot();
    callback clear-screenshot();
    callback add-split();
    callback open-library();
    // Developer builds can add the selected splits to the split library
    in property <bool> developer;
    callback add-to-library();
    callback duplicate-split();
    callback remove-split();
    callback move-split(bool);
    callback save-preset();
    callback save-preset-as-new();
    callback cancel-edit();
    callback show-problems();
    callback delete-preset();
    callback turn-on-grouping();

    // The split list's rows: the split's name over its file name, beside a picture
    property <length> row-height: 44px;
    // The rows' right padding, clear of the scroll bar, 14px wide over the rows when it shows
    property <length> list-padding: root.shown-rows * root.row-height > list.visible-height ? 20px : 6px;
    // The form's labels, so the fields line up
    property <length> label-width: 88px;

    // Goes to the next split with a problem, from the problem line or F8
    public function next-problem() {
        if (root.problem-split >= 0) {
            // Like clicking the list: a field being typed in commits first
            list-keys.focus();
            root.pick(root.problem-split);
        }
    }

    // Selects split `index`, scrolled into view
    public function pick(index: int) {
        root.selected = index;
        root.scroll-to(index);
        root.split-chosen(index);
    }

    // While a split from Split Library is dragged near the split list's top or bottom edge, the
    // list scrolls that way, -1 up or 1 down, and says so, so the line follows what's under the
    // pointer. 0 while it's not.
    property <int> drag-edge;
    callback drag-scrolled();
    // How fast it scrolls, and when it last did, so each step goes as far as the time since
    // the one before, however late a step comes
    property <length> drag-speed-per-second: 520px;
    property <duration> drag-scrolled-at;

    changed drag-edge => {
        root.drag-scrolled-at = animation-tick();
    }

    // How near the list's top or bottom edge a dragged split scrolls it: a row and a half
    property <length> drag-edge-zone: root.row-height * 1.5;

    // A split from Split Library is dragged with the pointer at `x` and `y` in the window: the
    // list scrolls while it's near the list's top or bottom edge. Returns the gap under it, like
    // drop-gap.
    // Past the list's top or bottom, but over its width, it keeps scrolling, with the line at
    // the gap nearest the pointer, since going past the edge is how a list is scrolled.
    public function drag-over(x: length, y: length) -> int {
        let left = list.absolute-position.x;
        if (x < left || x >= left + list.width) {
            root.drag-edge = 0;
            return -1;
        }
        let inside = y - list.absolute-position.y;
        root.drag-edge = inside < root.drag-edge-zone ? -1 : inside > list.visible-height - root.drag-edge-zone ? 1 : 0;
        root.drop-gap(x, list.absolute-position.y + clamp(inside, 0px, list.height - 1px))
    }

    // The drag ended, or left the list: the list stops scrolling
    public function drag-ended() {
        root.drag-edge = 0;
    }

    // Often, so it scrolls smoothly on fast screens
    Timer {
        interval: 8ms;
        running: root.drag-edge != 0;
        triggered => {
            let now = animation-tick();
            // At least the timer's own time, in case the tick hasn't moved on since no frame was
            // drawn, and at most a few frames' worth after a stall
            let elapsed = clamp(now - root.drag-scrolled-at, 8ms, 50ms);
            root.drag-scrolled-at = now;
            let lowest = min(0px, list.visible-height - root.rows.length * root.row-height);
            let step = root.drag-speed-per-second * (elapsed / 1s);
            list.content-y = clamp(list.content-y - root.drag-edge * step, lowest, 0px);
            root.drag-scrolled();
        }
    }

    // The gap between rows of the split list nearest to `x` and `y` in the window, from 0 above
    // the first to the number of rows below the last, or -1 when they're outside the list
    public function drop-gap(x: length, y: length) -> int {
        if (x < list.absolute-position.x || x >= list.absolute-position.x + list.width || y < list.absolute-position.y || y >= list.absolute-position.y + list.height) {
            return -1;
        }
        return clamp(round((y - list.absolute-position.y - list.content-y) / root.row-height), 0, root.rows.length);
    }

    // Scrolls split `index` into view, like after it's added or moved
    public function scroll-to(index: int) {
        // Where it's shown, past hidden splits that are off
        let place = index < root.rows.length ? root.rows[index].place : index;
        if (place * root.row-height < -list.content-y) {
            list.content-y = -place * root.row-height;
        }
        if ((place + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((place + 1) * root.row-height - list.visible-height);
        }
    }
    callback grab();
    callback use-screenshots();
    callback save-selected();
    callback save-all();
    callback test();
    callback copy-savestates();
    callback show-instructions();
    callback browse-folder();

    property <bool> saved-flash;
    // The rows whose split images were just saved, by index
    property <[bool]> saved-rows;

    // Split images were saved: their rows' pictures dim under a check mark for a moment, and the
    // output preview too when it shows one of them. After a grab the next split is selected, so
    // the check is on the row grabbed, not the preview.
    public function split-images-saved(rows: [bool], preview: bool) {
        root.saved-rows = rows;
        root.saved-flash = preview;
        // Restarting only resets a running timer, it doesn't start a stopped one
        flash-timer.running = true;
        flash-timer.restart();
    }

    flash-timer := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.running = false;
            root.saved-flash = false;
            root.saved-rows = [];
        }
    }
    callback generate-profile();
    callback blocked-clicked();

    // Two columns whose rows line up: the splits beside the previews, the list as tall as both
    click-away := ClickAway {}

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                // Without advanced, the rows have no file names to make room for
                width: root.details ? 480px : 360px;
                spacing: 6px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Label {
                        width: 46px;
                        text: "Game:";
                    }

                    if !root.editing: ComboBox {
                        model: root.games;
                        current-index <=> root.game-index;
                        selected => { root.game-chosen(root.game-index); }
                    }

                    // A game that has presets is picked, so its name can't be mistyped
                    if root.editing && !root.new-game: ComboBox {
                        model: root.edit-games;
                        current-index <=> root.edit-game-index;
                        selected => { root.edit-game-chosen(root.edit-game-index); }

                        Tooltip {
                            Tip {
                                text: "The game the preset is listed under. New game... types the name of one that has no presets yet.";
                            }
                        }
                    }

                    if root.editing && root.new-game: TextField {
                        text <=> root.edit-game;
                        placeholder-text: "The new game's name";
                        edited(text) => { root.game-edited(text); }
                    }

                    if root.editing && root.new-game && root.edit-games.length > 1: Button {
                        width: 60px;
                        text: "Games";
                        clicked => { root.pick-game(); }
                        tip: "Pick one of the games that have presets instead";
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Label {
                        width: 46px;
                        text: "Preset:";
                    }

                    if !root.editing: ComboBox {
                        model: root.presets;
                        current-index <=> root.preset-index;
                        selected => { root.preset-chosen(root.preset-index); }
                    }

                    if !root.editing && root.advanced: IconButton {
                        label: "Edit";
                        icon: Icons.edit;
                        enabled: root.presets.length > 0 && !root.working;
                        clicked => { root.edit-preset(); }
                        tip: "Edit this preset's splits, masks and settings";
                    }

                    if !root.editing && root.advanced: IconButton {
                        label: "New";
                        icon: Icons.new;
                        enabled: !root.working;
                        clicked => { root.new-preset(); }
                        tip: "Make a new preset for this game";
                    }

                    if !root.editing: IconButton {
                        label: "Import";
                        icon: Icons.import;
                        enabled: !root.working;
                        clicked => { root.import-preset(); }
                        tip: "Import a preset someone shared, from its .zip file";
                    }

                    if !root.editing && root.advanced: IconButton {
                        label: "Export";
                        icon: Icons.export;
                        enabled: root.presets.length > 0 && !root.working;
                        clicked => { root.export-preset(); }
                        tip: "Export this preset as a .zip file to share, with its masks, savestates and screenshots";
                    }

                    if root.editing: TextField {
                        text <=> root.edit-name;
                        placeholder-text: "The preset's name, like the category";
                        edited(text) => { root.name-edited(text); }
                    }
                }

                // Above the list, in place of the right column's folder in the advanced layout
                if !root.details: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Label {
                        width: 46px;
                        text: "Folder:";
                    }

                    // An icon like Import's above it, so the path has room
                    FolderPicker {
                        icon-only: true;
                        folder: root.output-folder;
                        browse => { root.browse-folder(); }
                    }
                }

                if root.details: Label {
                    height: 20px;
                    text: "Splits";
                }

                // The outline is outside, like the previews', so their edges line up. It's a field's,
                // since the white one is for the capture and image previews
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.field;

                    Rectangle {
                        x: -1px;
                        y: -1px;
                        width: parent.width + 2px;
                        height: parent.height + 2px;
                        border-width: 1px;
                        border-color: Theme.outline;
                    }

                    // Up and Down pick the split shown above or below, scrolled into view
                    list-keys := FocusScope {
                        height: parent.height - (root.show-strip ? root.strip-height : 0px);
                        y: 0px;

                        key-pressed(event) => {
                            // Not without rows, where the selected one is a default row
                            if (event.text == Key.UpArrow && root.selected < root.rows.length && root.rows[root.selected].above >= 0) {
                                root.pick(root.rows[root.selected].above);
                                return accept;
                            }
                            if (event.text == Key.DownArrow && root.selected < root.rows.length && root.rows[root.selected].below >= 0) {
                                root.pick(root.rows[root.selected].below);
                                return accept;
                            }
                            // Space turns the selected split on or off while choosing
                            if (event.text == " " && root.choosing && root.selected < root.rows.length && root.rows[root.selected].leader >= 0) {
                                root.split-toggled(root.selected);
                                return accept;
                            }
                            reject
                        }

                        list := ScrollView {
                            content-height: root.shown-rows * root.row-height;

                            // Splits that are off stay in the rows, hidden unless choosing, so a
                            // row's index is its split's, and shown ones take the places in turn
                            for row[index] in root.rows: row-box := Rectangle {
                                visible: !row.hidden;
                                y: row.place * root.row-height;
                                height: root.row-height;
                                width: parent.width;
                                background: index == root.selected ? Theme.selection.with-alpha(list-keys.has-focus ? 0.35 : 0.2) : row.shaded ? Theme.stripe : transparent;

                                SavedGlow {
                                    shown: root.saved-rows[index];
                                }

                                // A highlight on every split the hovered checkbox turns on or off,
                                // like the dummies before it, before it's clicked
                                if root.choosing && root.hovered-leader >= 0 && row.leader == root.hovered-leader: Rectangle {
                                    background: Theme.warning.with-alpha(0.16);
                                }

                                TouchArea {
                                    clicked => {
                                        list-keys.focus();
                                        root.pick(index);
                                    }
                                }

                                // Splits compared together are one block: a line only above the
                                // first, and a bar down the margin beside all of them
                                property <bool> joins-next: index + 1 < root.rows.length && root.rows[index + 1].joined;

                                if row.place > 0 && !row.joined: Rectangle {
                                    y: 0px;
                                    height: 1px;
                                    background: Theme.separator;
                                }

                                if row.joined || row-box.joins-next: Rectangle {
                                    x: 4px;
                                    y: row.joined ? 0px : 5px;
                                    width: 3px;
                                    height: root.row-height - self.y - (row-box.joins-next ? 0px : 5px);
                                    background: Theme.secondary-text;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    // Clear of the scroll bar, 14px wide over the rows when it shows
                                    padding-right: root.list-padding;
                                    spacing: 8px;

                                    // The split image at a glance, or an empty box until there's
                                    // something to make it from
                                    VerticalLayout {
                                        alignment: center;

                                        Rectangle {
                                            opacity: row.off ? 0.4 : 1;
                                            width: 48px;
                                            height: 36px;
                                            border-width: 1px;
                                            border-color: Theme.separator;

                                            if row.has-thumb: Image {
                                                x: 1px;
                                                y: 1px;
                                                width: parent.width - 2px;
                                                height: parent.height - 2px;
                                                source: row.thumb;
                                                image-fit: fill;
                                            }

                                            SavedCheck {
                                                size: 28px;
                                                shown: root.saved-rows[index];
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;

                                        Label {
                                            height: 18px;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: row.problem ? Theme.error : row.off ? Theme.secondary-text : Theme.text;
                                            text: row.heading;
                                        }

                                        // Clipped, so the labels and checkbox beside it keep their room
                                        if root.details: Rectangle {
                                            opacity: row.off ? 0.4 : 1;
                                            min-width: 0px;
                                            height: 16px;
                                            clip: true;

                                            FileName {
                                                parts: row.parts;
                                                file: row.file;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        // Not while choosing, which needs the room for the checkboxes and always on
                                        if root.details && !root.choosing: Label {
                                            height: 16px;
                                            horizontal-alignment: right;
                                            color: Theme.secondary-text;
                                            text: row.source;
                                        }

                                        // An image of a split that's off is still compared, since
                                        // it's in the folder
                                        // Whole, with the file name beside it clipped instead
                                        Label {
                                            height: 16px;
                                            min-width: self.preferred-width;
                                            horizontal-alignment: right;
                                            color: row.kept ? Theme.warning : Theme.reached;
                                            text: row.kept ? "still compared" : row.saved ? "saved" : "";
                                        }
                                    }

                                    // While choosing, that a split is always on. The checkboxes are
                                    // drawn over the rows, below, centered on the splits compared
                                    // together, and a split that goes with one is highlighted when
                                    // it's hovered
                                    if root.choosing: VerticalLayout {
                                        alignment: center;
                                        width: 64px;

                                        if row.always-on: Label {
                                            height: 16px;
                                            horizontal-alignment: right;
                                            color: Theme.secondary-text;
                                            text: "always on";

                                            Tooltip {
                                                Tip {
                                                    text: row.fixed;
                                                }
                                            }
                                        }

                                        // Why a dummy has no checkbox: the split it goes with,
                                        // which hovering that split's checkbox highlights too
                                        if !row.always-on && !row.toggleable && row.fixed != "": Rectangle {
                                            height: 20px;

                                            Tooltip {
                                                Tip {
                                                    text: row.fixed;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // While choosing, a checkbox for each split the runner turns on or off,
                            // over the rows so it's centered on the splits compared together with
                            // it. Clicks go to Rust through the area over it, which also says what
                            // hovering it would turn on or off. The box ticks itself from Space
                            // while it has focus, which drops its binding, so it's put back to what
                            // Rust has each time the row changes
                            for row[index] in root.rows: Rectangle {
                                visible: root.choosing && row.toggleable;
                                x: parent.width - root.list-padding - root.box-size;
                                y: row.box-top * root.row-height + (row.box-rows * root.row-height - root.box-size) / 2;
                                width: root.box-size;
                                height: root.box-size;
                                property <bool> on: !row.off;
                                changed on => {
                                    box.checked = self.on;
                                }

                                box := CheckBox {
                                    checked: !row.off;
                                    toggled => {
                                        list-keys.focus();
                                        root.split-toggled(index);
                                    }
                                }

                                box-area := TouchArea {
                                    clicked => {
                                        list-keys.focus();
                                        root.split-toggled(index);
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.hovered-leader = index;
                                        } else if (root.hovered-leader == index) {
                                            root.hovered-leader = -1;
                                        }
                                    }
                                }

                                Tooltip {
                                    Tip {
                                        text: "Split here. Off, the split gets no split image, and Grab and Save All skip it, with the splits that go with it, which are highlighted while the pointer is here. Your LiveSplit splits need a segment for each split that's on, apart from dummies.";
                                    }
                                }
                            }

                            // Where a split from Split Library goes: a line between the rows, with
                            // a dot at its start, over the separator
                            if root.drop-line >= 0: Rectangle {
                                y: clamp(root.drop-line * root.row-height - 1px, 0px, max(0px, root.shown-rows * root.row-height - 2px));
                                height: 2px;
                                width: parent.width;
                                background: Theme.focus;

                                Rectangle {
                                    x: 2px;
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.focus;
                                }
                            }
                        }
                    }

                    // How many splits are off, and the way to choose them, inside the list's
                    // outline so both layouts keep their size
                    if root.show-strip: Rectangle {
                        y: parent.height - root.strip-height;
                        height: root.strip-height;
                        background: Theme.stripe;

                        Rectangle {
                            y: 0px;
                            height: 1px;
                            background: Theme.separator;
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 3px;
                            padding-top: 3px;
                            padding-bottom: 2px;
                            spacing: 6px;

                            Label {
                                horizontal-stretch: 1;
                                color: !root.choosing && root.choice-kept ? Theme.warning : Theme.secondary-text;
                                text: root.choosing ? "Turn on the splits you split on." : root.choice-summary;

                                if !root.choosing && root.choice-kept: Tooltip {
                                    Tip {
                                        text: "A split that's off still has its image in the split image folder, so AutoSplit-rs still splits there. Choose Splits shows it as still compared. Turn it on and off again to be asked whether to delete its image.";
                                    }
                                }
                            }

                            Button {
                                text: root.choosing ? "Done" : "Choose Splits";
                                clicked => { root.choose-splits(); }
                                tip: root.choosing ? "Show only the splits that are on" : "Show every split, with a checkbox for each one you can turn on or off, like splits some runners don't split on";
                            }
                        }
                    }
                }

                // Where split images come from, then what's done with them, filling the list's
                // width like the savestate buttons fill the preview's, wider than their text
                if !root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Button {
                        horizontal-stretch: 1;
                        text: root.grab-fade ? "Grab*" : "Grab";
                        suggested: root.grab-suggested;
                        enabled: root.can-grab;
                        clicked => { root.grab(); }
                        tip: root.grab-blocker != "" ? root.grab-blocker : root.grab-fade ? "Fade splits are made from their color, not the capture. Grab* saves this one into the split image folder and goes to the next split. The screenshot hotkey does the same while this window is open." : "Make the selected split's image from the capture now, save it into the split image folder, and go to the next split. The screenshot hotkey does the same while this window is open.";
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Use Screenshots...";
                        // A fade split is made from its color, so it takes no screenshot
                        enabled: root.preset-problem == "" && !root.grab-fade;
                        clicked => { root.use-screenshots(); }
                        tip: root.grab-fade ? "The selected split is a fade split, which is made from its color, not a screenshot. Select another split to use screenshots." : "Make split images from screenshot files instead: one for the selected split, or several for the splits in order from the first, skipping fade splits";
                    }

                    if root.advanced: Button {
                        horizontal-stretch: 1;
                        text: "Test";
                        enabled: root.can-test;
                        clicked => { root.test(); }
                        tip: "Open the selected split's saved split image in the Live Tester";
                    }

                    if root.advanced: Button {
                        horizontal-stretch: 1;
                        text: "Save Selected";
                        enabled: root.can-save-selected;
                        clicked => { root.save-selected(); }
                        tip: "Write the selected split's split image into the split image folder, from its grab or screenshot, or a fade split's color";
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Save All";
                        suggested: !root.grab-suggested;
                        enabled: root.can-save-all;
                        clicked => { root.save-all(); }
                        tip: "Write the split images of every split with a grab or screenshot, and of every fade split, into the split image folder";
                    }
                }

                // The splits' order, out to the list's edges like the buttons they replace
                if root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    IconButton {
                        label: "Add";
                        icon: Icons.add;
                        clicked => { root.add-split(); }
                        tip: "Add a split after the selected one";
                    }

                    IconButton {
                        label: "Duplicate";
                        icon: Icons.duplicate;
                        enabled: root.has-split;
                        clicked => { root.duplicate-split(); }
                        tip: "Add a copy of the selected split after it, with the same mask";
                    }

                    IconButton {
                        label: "Remove";
                        icon: Icons.remove;
                        enabled: root.has-split;
                        clicked => { root.remove-split(); }
                        tip: "Remove the selected split. " + Keys.primary + "+Z brings it back, with its grab or screenshot, until something else is changed.";
                    }

                    Button {
                        text: "Library";
                        icon: Icons.folder;
                        clicked => { root.open-library(); }
                        tip: "Open the split library: ready-made splits for the preset's game, with their masks and settings, to insert around the selected split";
                    }

                    if root.developer: Button {
                        text: "Add to Library...";
                        enabled: root.has-split;
                        clicked => { root.add-to-library(); }
                        tip: "Make a ready-made split for the split library from the selected split, and the ones after it for one of several images (developer builds only)";
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        label: "Move Up";
                        icon: Icons.up;
                        enabled: root.has-split && root.selected > 0;
                        clicked => { root.move-split(true); }
                        tip: "Move the selected split up, with the splits compared together with it (Alt+Up)";
                    }

                    IconButton {
                        label: "Move Down";
                        icon: Icons.down;
                        enabled: root.has-split && root.selected < root.rows.length - 1;
                        clicked => { root.move-split(false); }
                        tip: "Move the selected split down, with the splits compared together with it (Alt+Down)";
                    }
                }
            }

            VerticalLayout {
                width: 320px;
                spacing: 6px;

                if !root.editing && root.advanced: Label {
                    height: 24px;
                    text: "Saves to the split image folder:";
                }

                if !root.editing && root.advanced: FolderPicker {
                    folder: root.output-folder;
                    browse => { root.browse-folder(); }
                }

                // A fade split is made from its color, so the capture isn't needed for it
                if !root.editing: Label {
                    height: 20px;
                    text: root.grab-fade ? "Fade Split" : "Capture Region";
                }

                if !root.editing: Preview {
                    height: 240px;
                    source: root.live-image;
                    // What's in the way of Grab*, like a missing split image folder, instead of pressing it
                    message: root.grab-fade ? "This split is a fade to a color, so it's made from its color, not the capture. There's no savestate to load for it.\n\n" + (root.grab-blocker != "" ? root.grab-blocker : "Grab* saves it and goes to the next split.") : root.live-message;
                }

                // The selected split, in place of the folder and the capture, which the output
                // preview below shows masked as it's edited. Taller than them, so the window
                // grows while editing: every field fits with its notes, and it only scrolls
                // when problems wrap over several lines.
                if root.editing: form-scroll := ScrollView {
                    height: 380px;
                    content-height: max(self.visible-height, form-panel.preferred-height);
                    content-width: self.visible-width;

                    form-panel := SplitFormPanel {
                        name-focus-request: root.name-focus-request;

                        width: form-scroll.visible-width;
                        height: form-scroll.content-height;
                        label-width: root.label-width;
                        has-split: root.has-split;
                        form: root.form;
                        kinds: root.kinds;
                        compares: root.compares;
                        split-edited(field) => { root.split-edited(field); }
                        choose-mask => { root.choose-mask(); }
                        choose-savestate => { root.choose-savestate(); }
                        clear-savestate => { root.clear-savestate(); }
                        clear-mask => { root.clear-mask(); }
                        choose-screenshot => { root.choose-screenshot(); }
                        clear-screenshot => { root.clear-screenshot(); }
                    }
                }

                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;

                    Label {
                        horizontal-stretch: 1;
                        text: "Output Preview";
                    }

                    // Only where there's one to go back to, after a grab or pick over it
                    if root.over-preset-screenshot: Button {
                        text: "Use Preset's";
                        clicked => { root.use-preset-screenshot(); }
                        tip: "Drop this split's grab or picked screenshot, and make its split image from the preset's screenshot again";
                    }

                    HorizontalLayout {
                        spacing: 3px;

                        if root.editing: IconToggle {
                            checked <=> root.preview-mask;
                            label: "Mask";
                            tip: "Apply the mask. Off shows the picture as it is.";
                            toggled => { root.preview-toggled(); }

                            MaskIcon { }
                        }

                        if root.editing: IconToggle {
                            checked <=> root.preview-live;
                            label: "Live capture";
                            tip: "Show the live capture. Off shows the split's grab or screenshot, or the mask itself when it has neither.";
                            toggled => { root.preview-toggled(); }

                            LiveIcon { }
                        }

                        IconToggle {
                            checked <=> root.show-grid;
                            label: "Transparency grid";
                            tip: "Show what the mask removes as a checkerboard. Clicking the Output Preview does this too.";

                            GridIcon { }
                        }
                    }
                }

                Preview {
                    height: 240px;
                    source: root.preview-image;
                    message: root.preview-message;
                    backdrop: root.show-grid ? root.grid-image : root.no-image;

                    TouchArea {
                        clicked => { root.show-grid = !root.show-grid; }
                    }

                    SavedCheck {
                        shown: root.saved-flash;
                    }
                }

                if !root.editing: HorizontalLayout {
                    height: 24px;
                    spacing: 6px;

                    Button {
                        horizontal-stretch: 1;
                        text: "Copy Savestates";
                        enabled: root.has-savestates;
                        clicked => { root.copy-savestates(); }
                        tip: "Put the preset's savestates on the clipboard, numbered like the split images, to paste where the practice tool on the console loads them from, like gz's savestate folder on the SD card";
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Savestate Instructions";
                        enabled: root.has-instructions;
                        clicked => { root.show-instructions(); }
                        tip: "Show what to do after loading the savestates that need more than loading, under the names Copy Savestates gives them";
                    }
                }

                if root.editing: HorizontalLayout {
                    height: 24px;
                    alignment: end;
                    spacing: 6px;

                    Button {
                        text: "Delete Preset...";
                        enabled: root.saved-preset;
                        clicked => { root.delete-preset(); }
                        tip: root.saved-preset ? "Delete this preset's folder, with the masks, savestates and screenshots in it. Split images you made with it stay." : "A new preset has nothing to delete yet. Cancel leaves it unsaved.";
                    }
                }
            }
        }

        if !root.editing: HorizontalLayout {
            height: 24px;
            spacing: 6px;

            // Hard to miss, so a recording isn't left running by accident
            if root.recording: Label {
                color: Theme.error;
                text: "Recording screenshots";
            }

            // Also while editing, where the status line is hidden
            if !root.recording && root.recording-note != "": Label {
                color: Theme.secondary-text;
                text: root.recording-note;
            }

            // Also beside the grouping warning, which is short so what was done still shows
            if root.preset-problem == "": Label {
                horizontal-stretch: 1;
                text: root.status;
            }

            if root.preset-problem != "": Label {
                horizontal-stretch: 1;
                color: Theme.error;
                text: root.preset-problem;

                Tooltip {
                    Tip {
                        text: "The preset has to be fixed before split images are made or savestates copied from it. " + root.preset-problem;
                    }
                }
            }

            if root.preset-problem != "": Button {
                text: "Fix It";
                enabled: !root.working;
                clicked => { root.edit-preset(); }
                tip: "Edit the preset to fix what the line beside it says";
            }

            if root.preset-problem == "" && root.needs-grouping: Label {
                color: Theme.error;
                text: "The profile has grouping off.";

                Tooltip {
                    Tip {
                        text: "This preset compares several images for one split: some splits are compared together, or there are several reset or start images. The split image folder only loads like that with Compare images with the same number for one split turned on in Settings.";
                    }
                }
            }

            if root.preset-problem == "" && root.needs-grouping: Button {
                text: "Turn It On";
                clicked => { root.turn-on-grouping(); }
                tip: "Turn on Compare images with the same number for one split in the profile, which this preset needs. Save the profile to keep it.";
            }

            Button {
                text: "Generate Profile...";
                // The profile is for this preset's split images, so it needs their folder
                enabled: root.presets.length > 0 && root.preset-problem == "" && root.output-folder != "";
                clicked => { root.generate-profile(); }
                tip: root.output-folder == "" ? "Needs a split image folder. Pick one with " + (root.advanced ? "Browse..." : "the folder button") + " first." : "Save the current settings as a new profile for this game and preset, using this split image folder. You can choose to load it afterwards.";
            }
        }

        if root.editing: HorizontalLayout {
            height: 24px;
            spacing: 6px;

            // Hovering shows every problem, clicking lists them in a message box
            if root.has-problems: VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.error;

                    Text {
                        text: "!";
                        color: white;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.show-problems(); }
                    }

                    Tooltip {
                        Tip {
                            text: root.problem-list;
                        }
                    }
                }
            }

            // Hard to miss, so a recording isn't left running by accident
            if root.recording: Label {
                color: Theme.error;
                text: "Recording screenshots";
            }

            // Also while editing, where the status line is hidden
            if !root.recording && root.recording-note != "": Label {
                color: Theme.secondary-text;
                text: root.recording-note;
            }

            Label {
                horizontal-stretch: 1;
                color: root.has-problems ? Theme.error : Theme.secondary-text;
                text: root.problems;

                // Goes to the split with the problem, then the next one each click
                TouchArea {
                    enabled: root.problem-split >= 0;
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.next-problem(); }
                }

                Tooltip {
                    Tip {
                        text: root.problem-list + (root.problem-split >= 0 ? "\n\nClick or press F8 to go to the next split with a problem. " + Keys.primary + "+S lists them all." : "");
                    }
                }
            }

            // A preset saved before can be saved as another, a new one only once
            if root.saved-preset: Button {
                text: "Save as New";
                enabled: !root.has-problems;
                clicked => { root.save-preset-as-new(); }
                tip: "Save these changes as a new preset, and leave this one as it was";
            }

            Button {
                text: "Cancel";
                clicked => { root.cancel-edit(); }
                tip: "Leave the preset as it was (Escape)";
            }

            Button {
                text: "Save";
                suggested: true;
                enabled: root.can-save-preset;
                clicked => { root.save-preset(); }
                tip: root.has-problems ? "Fix the problems first, which the line beside it lists" : "Save the preset (" + Keys.primary + "+S)";
            }
        }
    }

    if root.blocked: TouchArea {
        clicked => { root.blocked-clicked(); }
    }

    // Last, over everything else
    if root.inline-message.shown: MessageOverlay {
        message: root.inline-message;
        answered(button) => { root.inline-answered(button); }
    }
}
