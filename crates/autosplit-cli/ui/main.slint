// AutoSplit's main window, at the positions of AutoSplit's design.ui.

import { Palette } from "std-widgets.slint";
import { SettingsWindow, HotkeyRow, Setting } from "settings.slint";
import { AboutWindow } from "about.slint";
import { LogWindow } from "log.slint";
import { MessageWindow } from "message.slint";
import { InfoCell, TesterReading, TesterWindow } from "tester.slint";
import { MakerRow, MakerWindow, SplitField, SplitForm, SplitValues } from "maker.slint";
import { InstructionCard, InstructionsWindow } from "instructions.slint";
import { Button, ClickAway, Label, NameKind, NamePart, Preview, SpinBox, TextField, Theme, Tip, WindowFocus } from "widgets.slint";

export { SettingsWindow, HotkeyRow, Setting, AboutWindow, LogWindow, MessageWindow, InfoCell, NameKind, NamePart, TesterReading, TesterWindow, MakerRow, MakerWindow, SplitField, SplitForm, SplitValues, InstructionCard, InstructionsWindow, WindowFocus }

export struct SimilarityRow {
    live: string,
    highest: string,
    threshold: string,
}

// AutoSplit's "Similarity Viewer" box: live, highest and threshold of the current and reset
// images, with its grid lines. Grouped split images get a current image row each.
component SimilarityViewer inherits Rectangle {
    in property <string> current-live;
    in property <string> current-highest;
    in property <string> current-threshold;
    in property <bool> grouped;
    in property <[SimilarityRow]> group-rows;
    in property <string> reset-live;
    in property <string> reset-highest;
    in property <string> reset-threshold;

    // Qt's group box frame starts half a line below the top, where the title sits
    Rectangle {
        y: 7px;
        height: parent.height - 7px;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 3px;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: title.preferred-width + 6px;
        height: 16px;
        background: Palette.background;

        title := Label {
            text: "Similarity Viewer";
        }
    }

    property <[SimilarityRow]> rows: root.grouped ? root.group-rows : [
        { live: root.current-live, highest: root.current-highest, threshold: root.current-threshold },
    ];
    property <length> reset-y: 39px + root.rows.length * 22px;

    for row[index] in root.rows: Rectangle {
        y: 39px + index * 22px;
        height: 22px;

        Rectangle {
            y: 0px;
            height: 1px;
            background: Palette.border;
        }

        for cell in [
            { x: 10px, y: 3px, width: 111px, text: root.grouped ? "Current Image (\{index + 1})" : "Current Image", center: false },
            { x: 133px, y: 4px, width: 57px, text: row.live, center: true },
            { x: 197px, y: 4px, width: 57px, text: row.highest, center: true },
            { x: 260px, y: 4px, width: 57px, text: row.threshold, center: true },
        ]: Label {
            x: cell.x;
            y: cell.y;
            width: cell.width;
            height: 16px;
            text: cell.text;
            horizontal-alignment: cell.center ? center : left;
        }
    }

    Rectangle {
        y: root.reset-y;
        height: 1px;
        background: Palette.border;
    }

    for line in [{ x: 129px }, { x: 193px }, { x: 257px }]: Rectangle {
        x: line.x;
        y: 20px;
        width: 1px;
        height: parent.height - 21px;
        background: Palette.border;
    }

    for cell in [
        { x: 133px, y: 22px, width: 57px, text: "Live", center: true },
        { x: 197px, y: 22px, width: 57px, text: "Highest", center: true },
        { x: 261px, y: 22px, width: 56px, text: "Threshold", center: true },
        { x: 10px, y: root.reset-y + 3px, width: 111px, text: "Reset Image", center: false },
        { x: 133px, y: root.reset-y + 3px, width: 57px, text: root.reset-live, center: true },
        { x: 197px, y: root.reset-y + 3px, width: 57px, text: root.reset-highest, center: true },
        { x: 260px, y: root.reset-y + 3px, width: 57px, text: root.reset-threshold, center: true },
    ]: Label {
        x: cell.x;
        y: cell.y;
        width: cell.width;
        height: 16px;
        text: cell.text;
        horizontal-alignment: cell.center ? center : left;
    }
}

export component MainWindow inherits Window {
    in property <string> window-title: "AutoSplit";
    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    default-font-size: 12px;

    in property <string> split-image-folder: "No Folder Selected";
    in property <bool> running;
    in property <string> device-name: "-";
    // Changes when the region is set for the user, like by Crop to 4:3: what was being typed in
    // its fields is dropped, and they show the new region
    in property <int> region-generation;
    in-out property <float> region-x;
    in-out property <float> region-y;
    in-out property <float> region-width;
    in-out property <float> region-height;
    in property <image> live-image;
    in property <string> live-message;
    in property <string> current-image-file: "-";
    in property <image> current-image;
    in property <string> current-image-message;
    // The split's images in a 2x2 grid instead of the current image. Empty tiles say None.
    in property <bool> current-grid;
    in property <[image]> current-tiles;
    in property <string> current-live: "-";
    in property <string> current-highest: "-";
    in property <string> current-threshold: "-";
    // Split images with the same number are compared for one split: a row for each
    in property <bool> group-split-images;
    in property <[SimilarityRow]> group-rows;
    in property <string> reset-live: "-";
    in property <string> reset-highest: "-";
    in property <string> reset-threshold: "-";
    in property <string> image-loop: "N/A";
    in property <string> start-image-status: "not found";
    in property <bool> can-start: true;
    in property <bool> can-reset;
    in property <bool> can-skip;
    in property <bool> can-undo;
    in property <bool> can-next;
    in property <bool> can-previous;
    // A message box is open, which AutoSplit's are modal
    in property <bool> blocked;
    // The tool window that's open, which this window can't be used beside, or empty
    in property <string> tool;

    callback browse-folder();
    callback region-edited(float, float, float, float);
    callback take-screenshot();
    callback start-auto-splitter();
    callback reset();
    callback skip-split();
    callback undo-split();
    callback next-image();
    callback previous-image();
    callback reload-split-images();
    callback open-settings();
    callback open-tester();
    callback save-profile();
    callback save-profile-as();
    callback load-profile();
    callback view-help();
    callback view-log();
    callback about();
    callback blocked-clicked();
    callback open-maker();
    callback close-tool();
    callback crop-to-4x3();

    // The last screenshot's file name, shown under Take Screenshot for a few seconds
    property <string> saved-screenshot;

    // A screenshot was saved as `file`
    public function screenshot-saved(file: string) {
        root.saved-screenshot = file;
        // Restarting only resets a running timer, it doesn't start a stopped one
        note-timer.running = true;
        note-timer.restart();
    }

    note-timer := Timer {
        interval: 5s;
        running: false;
        triggered => {
            self.running = false;
            root.saved-screenshot = "";
        }
    }

    function region-changed() {
        root.region-edited(root.region-x, root.region-y, root.region-width, root.region-height);
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Settings";
                shortcut: @keys(Control + ",");
                activated => { root.open-settings(); }
            }
            MenuItem {
                title: "Live Tester";
                shortcut: @keys(Control + T);
                activated => { root.open-tester(); }
            }
            MenuItem {
                title: "Make Split Images";
                shortcut: @keys(Control + M);
                activated => { root.open-maker(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Save Profile";
                shortcut: @keys(Control + S);
                activated => { root.save-profile(); }
            }
            MenuItem {
                title: "Save Profile As...";
                shortcut: @keys(Control + Shift + S);
                activated => { root.save-profile-as(); }
            }
            MenuItem {
                title: "Load Profile";
                shortcut: @keys(Control + O);
                activated => { root.load-profile(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "View Help";
                shortcut: @keys(F1);
                activated => { root.view-help(); }
            }
            MenuItem {
                title: "View Log";
                activated => { root.view-log(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "About AutoSplit";
                activated => { root.about(); }
            }
        }
    }

    // AutoSplit's 786x404 window below its menu bar, taller for the similarity viewer's extra
    // rows. The layout sizes the window to fit it.
    property <length> extra-rows-height: root.group-split-images ? (root.group-rows.length - 1) * 22px : 0px;

    click-away := ClickAway {}

    VerticalLayout {
        Rectangle {
            width: 786px;
            height: 404px + root.extra-rows-height;

            Label {
                x: 10px;
                y: 9px;
                width: 111px;
                height: 16px;
                text: "Split Image Folder:";
            }

            TextField {
                x: 127px;
                y: 6px;
                width: 561px;
                height: 22px;
                read-only: true;
                text: root.split-image-folder;
            }

            Button {
                x: 696px;
                y: 5px;
                width: 81px;
                height: 24px;
                text: "Browse...";
                enabled: !root.running;
                clicked => { root.browse-folder(); }
            }

            Label {
                x: 127px;
                y: 31px;
                width: 318px;
                height: 20px;
                text: "Capture Region";
                horizontal-alignment: center;
            }

            Label {
                x: 127px;
                y: 49px;
                width: 318px;
                height: 18px;
                text: root.device-name;
                horizontal-alignment: center;
            }

            Label {
                x: 456px;
                y: 31px;
                width: 318px;
                height: 20px;
                text: "Current Image";
                horizontal-alignment: center;
            }

            Button {
                x: 455px;
                y: 49px;
                width: 27px;
                height: 18px;
                text: "<";
                enabled: root.can-previous;
                clicked => { root.previous-image(); }
                tip: "Previous image";
            }

            Label {
                x: 484px;
                y: 49px;
                width: 264px;
                height: 18px;
                text: root.current-image-file;
                horizontal-alignment: center;
            }

            Button {
                x: 750px;
                y: 49px;
                width: 27px;
                height: 18px;
                text: ">";
                enabled: root.can-next;
                clicked => { root.next-image(); }
                tip: "Next image";
            }

            Label {
                x: 11px;
                y: 67px;
                width: 49px;
                height: 20px;
                text: "X";
                horizontal-alignment: center;
            }

            Label {
                x: 66px;
                y: 67px;
                width: 49px;
                height: 20px;
                text: "Y";
                horizontal-alignment: center;
            }

            SpinBox {
                x: 11px;
                y: 87px;
                width: 51px;
                height: 24px;
                maximum: 999999999;
                generation: root.region-generation;
                value <=> root.region-x;
                edited => { root.region-changed(); }
            }

            SpinBox {
                x: 66px;
                y: 87px;
                width: 51px;
                height: 24px;
                maximum: 999999999;
                generation: root.region-generation;
                value <=> root.region-y;
                edited => { root.region-changed(); }
            }

            Label {
                x: 11px;
                y: 112px;
                width: 49px;
                height: 20px;
                text: "Width";
                horizontal-alignment: center;
            }

            Label {
                x: 66px;
                y: 112px;
                width: 49px;
                height: 20px;
                text: "Height";
                horizontal-alignment: center;
            }

            SpinBox {
                x: 11px;
                y: 132px;
                width: 51px;
                height: 24px;
                minimum: 1;
                maximum: 10000;
                generation: root.region-generation;
                value <=> root.region-width;
                edited => { root.region-changed(); }
            }

            SpinBox {
                x: 66px;
                y: 132px;
                width: 51px;
                height: 24px;
                minimum: 1;
                maximum: 10000;
                generation: root.region-generation;
                value <=> root.region-height;
                edited => { root.region-changed(); }
            }

            Button {
                x: 10px;
                y: 162px;
                width: 107px;
                height: 24px;
                text: "Crop to 4:3";
                clicked => {
                    // Out of the field being typed in, without an outline staying on the button
                    click-away.focus();
                    root.crop-to-4x3();
                }
                tip: "Set the region to the 4:3 picture in the middle of the capture, like a 4:3 game in OBS's 16:9 canvas: X 240, Width 1440 in 1920x1080";
            }

            Button {
                x: 10px;
                y: 192px;
                width: 107px;
                height: 24px;
                text: "Take Screenshot";
                clicked => { root.take-screenshot(); }
            }

            Text {
                x: 10px;
                y: 220px;
                width: 107px;
                wrap: word-wrap;
                font-size: 11px;
                color: Theme.secondary-text;
                text: root.saved-screenshot == "" ? "" : "Saved " + root.saved-screenshot;
            }

            Preview {
                x: 127px;
                y: 67px;
                width: 320px;
                height: 240px;
                source: root.live-image;
                message: root.live-message;
            }

            Preview {
                x: 456px;
                y: 67px;
                width: 320px;
                height: 240px;
                visible: !root.current-grid;
                source: root.current-image;
                message: root.current-image-message;
            }

            for tile[index] in root.current-tiles: Preview {
                x: 456px + mod(index, 2) * 160px;
                y: 67px + floor(index / 2) * 120px;
                width: 160px;
                height: 120px;
                visible: root.current-grid;
                source: tile;
                message: tile.width == 0 ? "None" : "";
            }

            SimilarityViewer {
                x: 127px;
                y: 312px;
                width: 321px;
                height: 84px + root.extra-rows-height;
                current-live: root.current-live;
                current-highest: root.current-highest;
                current-threshold: root.current-threshold;
                grouped: root.group-split-images;
                group-rows: root.group-rows;
                reset-live: root.reset-live;
                reset-highest: root.reset-highest;
                reset-threshold: root.reset-threshold;
            }

            Label {
                x: 458px;
                y: 313px;
                width: 81px;
                height: 20px;
                text: "Image Loop:";
            }

            Label {
                x: 537px;
                y: 313px;
                width: 121px;
                height: 20px;
                text: root.image-loop;
            }

            Label {
                x: 458px;
                y: 344px;
                width: 121px;
                height: 20px;
                text: "Start Image Status:";
            }

            Label {
                x: 577px;
                y: 344px;
                width: 81px;
                height: 20px;
                text: root.start-image-status;
            }

            Button {
                x: 457px;
                y: 369px;
                width: 131px;
                height: 27px;
                text: "Reload Split Images";
                enabled: !root.running;
                clicked => { root.reload-split-images(); }
            }

            Button {
                x: 657px;
                y: 310px;
                width: 59px;
                height: 27px;
                text: "Undo";
                enabled: root.can-undo;
                clicked => { root.undo-split(); }
            }

            Button {
                x: 719px;
                y: 310px;
                width: 59px;
                height: 27px;
                text: "Skip";
                enabled: root.can-skip;
                clicked => { root.skip-split(); }
            }

            Button {
                x: 657px;
                y: 339px;
                width: 121px;
                height: 27px;
                text: "Reset";
                enabled: root.can-reset;
                clicked => { root.reset(); }
            }

            Button {
                x: 657px;
                y: 369px;
                width: 121px;
                height: 27px;
                text: root.running ? "Running..." : "Start Auto Splitter";
                enabled: root.can-start;
                clicked => { root.start-auto-splitter(); }
            }
        }
    }

    if root.blocked || root.tool != "": TouchArea {
        clicked => { root.blocked-clicked(); }
        // A spin box under it would take the wheel and show a value the profile doesn't get
        scroll-event(event) => { accept }
    }

    // Dimmed while a tool window is open, so it's clear why nothing here responds
    if root.tool != "": Rectangle {
        background: Palette.background.with-alpha(0.8);

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                // Solid, so what's dimmed behind doesn't run into its text
                Rectangle {
                    background: Palette.background;
                    border-width: 1px;
                    border-radius: 4px;
                    border-color: Theme.outline;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        Text {
                            horizontal-alignment: center;
                            text: root.tool + " is open";
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.text;
                        }

                        Text {
                            horizontal-alignment: center;
                            text: "Close it to use this window, or open Settings beside it.";
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Button {
                                width: 160px;
                                height: 27px;
                                text: "Close " + root.tool;
                                enabled: !root.blocked;
                                clicked => { root.close-tool(); }
                            }

                            Button {
                                width: 90px;
                                height: 27px;
                                text: "Settings";
                                enabled: !root.blocked;
                                clicked => { root.open-settings(); }
                                tip: "Open Settings beside the tool window, like File > Settings and Ctrl+, do";
                            }
                        }

                        // The run goes on beside the tool window
                        if root.running: HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Button {
                                width: 59px;
                                height: 27px;
                                text: "Undo";
                                enabled: root.can-undo && !root.blocked;
                                clicked => { root.undo-split(); }
                            }

                            Button {
                                width: 59px;
                                height: 27px;
                                text: "Skip";
                                enabled: root.can-skip && !root.blocked;
                                clicked => { root.skip-split(); }
                            }

                            Button {
                                width: 59px;
                                height: 27px;
                                text: "Reset";
                                enabled: root.can-reset && !root.blocked;
                                clicked => { root.reset(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
