// About AutoSplit, like AutoSplit's about.ui.

import { Button, Theme } from "widgets.slint";

export component AboutWindow inherits Window {
    title: "About AutoSplit";
    icon: @image-url("../assets/icon.png");
    width: 264px;
    height: 250px;
    default-font-size: 12px;

    in property <string> version;
    callback ok();
    callback open-link(string);
    // The license and third-party notices, which are built into the program
    callback open-licenses();

    Text {
        color: Theme.text;
        x: 10px;
        y: 21px;
        width: 170px;
        height: 16px;
        text: "Version: " + root.version;
    }

    Text {
        color: Theme.text;
        x: 10px;
        y: 44px;
        width: 244px;
        wrap: word-wrap;
        text: "A Rust rewrite of AutoSplit. AutoSplit was created by Toufool and Faschz, and is maintained by Avasam.";
    }

    Text {
        color: Theme.text;
        x: 10px;
        y: 110px;
        width: 244px;
        wrap: word-wrap;
        text: "Free software under the GNU General Public License v3.0, like AutoSplit.";
    }

    Text {
        x: 10px;
        y: 160px;
        width: 244px;
        text: "AutoSplit-rs on GitHub";
        color: Theme.link;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-link("https://github.com/TorjeAmundsen/AutoSplit-rs"); }
        }
    }

    Text {
        x: 10px;
        y: 182px;
        width: 244px;
        text: "AutoSplit on GitHub";
        color: Theme.link;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-link("https://github.com/Toufool/AutoSplit"); }
        }
    }

    Button {
        x: 10px;
        y: 220px;
        width: 75px;
        height: 24px;
        text: "Licenses";
        clicked => { root.open-licenses(); }
    }

    Button {
        x: 180px;
        y: 220px;
        width: 75px;
        height: 24px;
        text: "OK";
        clicked => { root.ok(); }
    }
}
