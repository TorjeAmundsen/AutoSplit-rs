// About AutoSplit, like AutoSplit's about.ui.

import { Button } from "std-widgets.slint";

export component AboutWindow inherits Window {
    title: "About AutoSplit";
    width: 264px;
    height: 250px;
    default-font-size: 12px;

    in property <string> version;
    callback ok();
    callback open-link(string);

    Text {
        x: 10px;
        y: 21px;
        width: 170px;
        height: 16px;
        text: "Version: " + root.version;
    }

    Text {
        x: 10px;
        y: 44px;
        width: 244px;
        wrap: word-wrap;
        text: "A rewrite in Rust of AutoSplit, created by Toufool and Faschz, maintained by Avasam.";
    }

    Text {
        x: 10px;
        y: 110px;
        width: 244px;
        wrap: word-wrap;
        text: "Free software under the GNU General Public License v3.0, like AutoSplit.";
    }

    Text {
        x: 10px;
        y: 160px;
        width: 244px;
        text: "AutoSplit on GitHub";
        color: #3478f6;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-link("https://github.com/Toufool/AutoSplit"); }
        }
    }

    Button {
        x: 180px;
        y: 216px;
        width: 75px;
        height: 26px;
        text: "OK";
        clicked => { root.ok(); }
    }
}
