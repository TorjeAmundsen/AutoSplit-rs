// Widgets drawn like AutoSplit's, which uses Qt's Fusion style: compact gradient buttons and spin
// boxes and combo boxes with arrows, so text fits at AutoSplit's sizes. Check boxes are Slint's.

// One font on every system, so text takes the same room everywhere. Each window sets it as its
// default. File names and colors use its monospace sibling, so their settings line up.
import "../assets/fonts/NotoSans-Regular.ttf";
import "../assets/fonts/NotoSans-SemiBold.ttf";
import "../assets/fonts/NotoSans-Bold.ttf";
import "../assets/fonts/NotoSansMono-Regular.ttf";
import "../assets/fonts/NotoSansMono-SemiBold.ttf";

import { ListView, Palette } from "std-widgets.slint";

// The bundled fonts' names, for text that sets its own
export global Fonts {
    out property <string> sans: "Noto Sans";
    out property <string> mono: "Noto Sans Mono";
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> outline: dark ? #151515 : #a5a5a5;
    out property <color> button-top: dark ? #545454 : #f6f6f6;
    out property <color> button-bottom: dark ? #474747 : #e4e4e4;
    out property <color> button-highlight: dark ? #696969 : #ffffff;
    out property <color> field: dark ? #2d2d2d : #ffffff;
    out property <color> text: dark ? #ffffff : #1e1e1e;
    out property <color> disabled-text: dark ? #8c8c8c : #a0a0a0;
    // Text that says something but is less important, like labels and notes. Darker than
    // disabled text, so it reads well on white
    out property <color> secondary-text: dark ? #a8a8a8 : #6b6b6b;
    out property <color> arrow: dark ? #bebebe : #4a4a4a;
    out property <color> focus: dark ? #2a82da : #308cc6;
    // Only around the capture and image previews, which it sets apart
    out property <color> frame: dark ? #ffffff : #a0a0a0;
    out property <color> selection: dark ? #2a82da : #308cc6;
    out property <color> link: dark ? #5aa0ff : #2a6fd6;
    // A similarity that reaches its threshold
    out property <color> reached: dark ? #6cd688 : #1e8c3a;
    // A similarity that hasn't reached its threshold yet, in the Live Tester's meter
    out property <color> meter: dark ? #3d9bff : #1f6fe0;
    // The highest similarity's mark in the Live Tester's meter
    out property <color> highest: dark ? #ffb84d : #d97706;
    // The Live Tester's noise in red, green and blue, each in its channel's color
    out property <color> red-channel: dark ? #ff7a7a : #c42b1c;
    out property <color> green-channel: dark ? #7ee08f : #1e8c3a;
    out property <color> blue-channel: dark ? #7ab4ff : #1f6fe0;
    // Something that's ignored, like a value in a split image's name
    out property <color> warning: dark ? #e0a040 : #a65f00;
    // Something that has to be fixed, like a split without a mask
    out property <color> error: dark ? #ff7070 : #c42b1c;
    out property <color> tooltip: dark ? #2d2d2d : #ffffdc;
    out property <color> item-hover: dark ? #3d3d3d : #e5e5e5;
    // Between items in a list, like the splits in Make Split Images
    out property <color> separator: dark ? #3a3a3a : #e0e0e0;
    // Every other item in a list, to tell them apart
    out property <color> stripe: dark ? #333333 : #f4f4f4;
    out property <color> tab: dark ? Palette.background.darker(20%) : Palette.background.darker(10%);
    // The light line inside the current tab and along the top of its page
    out property <color> tab-highlight: dark ? Palette.background.brighter(80%) : #ffffff;
}

// Whether the window is the active one. Losing focus to another window isn't finishing an edit,
// like Qt's editingFinished ignores it, so fields only commit while this is true. Set from Rust.
export global WindowFocus {
    in-out property <bool> active: true;
}

// The name of the key shortcuts are held with, for tooltips: Cmd on macOS, Ctrl elsewhere, like
// the shortcuts themselves.
export global Keys {
    out property <string> primary: Platform.os == OperatingSystemType.macos ? "Cmd" : "Ctrl";
}

// Whether a ComboBox's list is showing. Escape closes it then, not the window or what the window
// would cancel with it, which Rust checks here.
export global OpenList {
    in-out property <bool> showing;
}

// Behind everything else in a window: a click where nothing else takes it, like on a label or
// empty space, takes the focus from the field or button that has it, so no outline stays behind.
// Keys it gets are left to the window.
export component ClickAway inherits FocusScope {
    width: 100%;
    height: 100%;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.focus();
            }
        }
    }
}

// A tooltip's content, drawn like Qt's: plain text in a box. Used as `Tooltip { Tip { text: ... } }`.
// Slint draws tooltips inside the window and cuts off what's past its edge, so long text wraps at
// a width that fits the narrowest windows that have tooltips, like Settings.
export component Tip inherits Rectangle {
    in property <string> text;
    background: Theme.tooltip;
    border-width: 1px;
    border-color: Theme.outline;
    // The tooltip's popup takes the preferred size, not the size
    preferred-width: min(unwrapped.preferred-width, 300px) + 8px;
    preferred-height: body.preferred-height + 8px;
    width: self.preferred-width;
    height: self.preferred-height;

    // Only measures the text on one line, for short tips that don't need the whole width
    unwrapped := Text {
        visible: false;
        text: root.text;
    }

    body := Text {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        text: root.text;
        wrap: word-wrap;
        color: Theme.text;
    }
}

export component Label inherits Text {
    vertical-alignment: center;
    overflow: elide;
    color: Theme.text;
}

// A preview area: the image stretched to fill it like AutoSplit's, or a message. The outline is
// drawn just outside, so the image gets the whole size.
export component Preview inherits Rectangle {
    in property <image> source;
    in property <string> message;
    // Shown behind the image, like a transparency grid
    in property <image> backdrop;

    Image {
        width: 100%;
        height: 100%;
        source: root.backdrop;
        image-fit: fill;
        visible: root.message == "";
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: fill;
        visible: root.message == "";
    }

    Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-width: 1px;
        border-color: Theme.frame;
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.message;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text;
    }
}

// The face of a button or a spin box arrow: Fusion's gradient with a light top edge.
// A 1px outline with Qt Fusion's 2px rounded corners: the corner pixel is left out and a
// pixel inside it rounds the corner. A half-strength pixel there looked like a gap on light
// backgrounds, so it is drawn in full. Slint's own rounded border blends the fill into the corner
// pixel, which shows as a brighter dot.
component Outline inherits Rectangle {
    in property <color> line: Theme.outline;

    for edge in [
        { x: 2px, y: 0px, w: root.width - 4px, h: 1px },
        { x: 2px, y: root.height - 1px, w: root.width - 4px, h: 1px },
        { x: 0px, y: 2px, w: 1px, h: root.height - 4px },
        { x: root.width - 1px, y: 2px, w: 1px, h: root.height - 4px },
    ]: Rectangle {
        x: edge.x;
        y: edge.y;
        width: edge.w;
        height: edge.h;
        background: root.line;
    }

    for corner in [
        { x: 1px, y: 1px },
        { x: root.width - 2px, y: 1px },
        { x: 1px, y: root.height - 2px },
        { x: root.width - 2px, y: root.height - 2px },
    ]: Rectangle {
        x: corner.x;
        y: corner.y;
        width: 1px;
        height: 1px;
        background: root.line;
    }
}

// The face of a button or a spin box arrow: Fusion's gradient with a light top edge.
component Face inherits Rectangle {
    in property <bool> pressed;
    in property <bool> hovered;
    in property <color> outline-color: Theme.outline;
    // Laid over the face, like for a suggested button
    in property <color> tint: transparent;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: root.pressed
            ? @linear-gradient(180deg, Theme.button-bottom 0%, Theme.button-bottom 100%)
            : @linear-gradient(180deg, root.hovered ? Theme.button-top.brighter(8%) : Theme.button-top 0%, Theme.button-bottom 100%);

        Rectangle {
            background: root.tint;
        }
    }

    Rectangle {
        x: 2px;
        y: 1px;
        width: parent.width - 4px;
        height: 1px;
        background: Theme.button-highlight;
        visible: !root.pressed;
    }

    Outline {
        width: 100%;
        height: 100%;
        line: root.outline-color;
    }
}

// A button's 16px icon from Icons, in the color of the window's other icons
component ButtonIcon inherits Image {
    in property <bool> enabled;
    width: 16px;
    height: 16px;
    colorize: root.enabled ? Theme.arrow : Theme.disabled-text;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // The default button of a dialog, which Enter presses, drawn with the focus color
    in property <bool> primary;
    // The likely next step, like Grab, tinted with the focus color but outlined like the others,
    // so only the focus has its outline
    in property <bool> suggested;
    // Its tooltip, or none when empty
    in property <string> tip;
    // A 16px icon from Icons before the text, or none
    in property <image> icon;
    // The pointer is over it while it can be clicked
    out property <bool> hovered: touch.has-hover && root.enabled;
    callback clicked();
    property <bool> has-icon: root.icon.width > 0;
    // ButtonIcon's size
    property <length> icon-size: 16px;
    // Between the icon and the text, when it has both
    property <length> icon-gap: root.has-icon && root.text != "" ? 5px : 0px;
    preferred-width: max(75px, label.preferred-width + 20px + (root.has-icon ? root.icon-size : 0px) + root.icon-gap);
    preferred-height: 24px;
    // Layouts don't stretch it, like Qt's buttons, and keep it as wide as its text unless
    // they're given horizontal-stretch
    max-height: 24px;
    min-height: 24px;
    horizontal-stretch: 0;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;

    Face {
        width: 100%;
        height: 100%;
        pressed: touch.pressed && root.enabled;
        hovered: touch.has-hover && root.enabled;
        outline-color: root.primary || focus.has-focus ? Theme.focus : Theme.outline;
        tint: root.suggested && root.enabled ? Theme.focus.with-alpha(0.18) : transparent;
    }

    HorizontalLayout {
        x: 2px;
        width: parent.width - 4px;
        height: 100%;
        alignment: center;
        spacing: root.icon-gap;

        if root.has-icon && root.text != "": Rectangle {
            width: root.icon-size;

            ButtonIcon {
                source: root.icon;
                enabled: root.enabled;
            }
        }

        label := Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // An icon without text, in the middle, where the layout's empty text would push it aside
    if root.has-icon && root.text == "": ButtonIcon {
        source: root.icon;
        enabled: root.enabled;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: default;
        clicked => {
            root.clicked();
        }
    }

    // Zero width, so a click reaches the touch area instead of taking the focus first
    focus := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if root.tip != "": Tooltip {
        Tip {
            text: root.tip;
        }
    }
}

// A small button that stays pressed while it's on, drawn like Button, with an icon its children
// draw in the middle, like the Output Preview's toggles.
export component IconToggle inherits Rectangle {
    in-out property <bool> checked;
    // What it toggles, for screen readers
    in property <string> label;
    // Its tooltip, or none when empty
    in property <string> tip;
    callback toggled();
    width: 24px;
    height: 20px;
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.label;

    function toggle() {
        root.checked = !root.checked;
        root.toggled();
    }

    Face {
        width: 100%;
        height: 100%;
        pressed: root.checked || touch.pressed;
        hovered: touch.has-hover;
        outline-color: focus.has-focus ? Theme.focus : Theme.outline;
        tint: root.checked ? Theme.focus.with-alpha(0.25) : transparent;
    }

    @children

    touch := TouchArea {
        mouse-cursor: default;
        clicked => {
            root.toggle();
        }
    }

    // Zero width, so a click reaches the touch area instead of taking the focus first
    focus := FocusScope {
        x: 0;
        width: 0px;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    if root.tip != "": Tooltip {
        Tip {
            text: root.tip;
        }
    }
}

// A small square Button with only a 16px icon from Icons, like the Output Preview's toggles.
export component IconButton inherits Button {
    // What it does, for screen readers
    in property <string> label;
    width: 24px;
    accessible-label: root.label;
}

// The icons of buttons, from Bootstrap Icons, drawn in one color that colorize sets. Their files
// are named like these, so another icon set only needs other files.
export global Icons {
    out property <image> edit: @image-url("../assets/icons/edit.svg");
    out property <image> new: @image-url("../assets/icons/new.svg");
    out property <image> add: @image-url("../assets/icons/add.svg");
    out property <image> duplicate: @image-url("../assets/icons/duplicate.svg");
    out property <image> remove: @image-url("../assets/icons/remove.svg");
    out property <image> up: @image-url("../assets/icons/up.svg");
    out property <image> down: @image-url("../assets/icons/down.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> import: @image-url("../assets/icons/import.svg");
    out property <image> export: @image-url("../assets/icons/export.svg");
}

// A checkerboard, for the transparency grid's toggle
export component GridIcon inherits Rectangle {
    width: 12px;
    height: 12px;
    border-width: 1px;
    border-color: Theme.arrow;

    for cell in [0, 2, 4, 6, 8]: Rectangle {
        x: mod(cell, 3) * 4px;
        y: floor(cell / 3) * 4px;
        width: 4px;
        height: 4px;
        background: Theme.arrow;
    }
}

// A dark tile with a light hole, like a mask that keeps the middle, for the mask's toggle
export component MaskIcon inherits Rectangle {
    width: 14px;
    height: 12px;
    background: Theme.arrow;

    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.field;
    }
}

// A red dot, like a camera's live light, for the live capture's toggle
export component LiveIcon inherits Rectangle {
    width: 9px;
    height: 9px;
    border-radius: 4.5px;
    background: Theme.dark ? #ff5a52 : #d93025;
}

// A drop-down list drawn like Fusion's: a button face with the current item and an arrow, and a
// plain list below it. Up and Down pick the next item without opening it, like Qt.
export component ComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(string);
    property <bool> list-showing: popup.is-open;
    preferred-height: 24px;
    forward-focus: focus;
    accessible-role: combobox;

    changed list-showing => {
        OpenList.showing = self.list-showing;
    }
    accessible-value: root.model[root.current-index];

    function select(index: int) {
        if (index >= 0 && index < root.model.length && index != root.current-index) {
            root.current-index = index;
            root.selected(root.model[index]);
        }
    }

    Face {
        width: 100%;
        height: 100%;
        pressed: touch.pressed && root.enabled;
        hovered: touch.has-hover && root.enabled;
        outline-color: focus.has-focus ? Theme.focus : Theme.outline;
    }

    Text {
        x: 6px;
        width: parent.width - 26px;
        height: 100%;
        text: root.model[root.current-index];
        color: root.enabled ? Theme.text : Theme.disabled-text;
        vertical-alignment: center;
        overflow: elide;
    }

    Path {
        x: parent.width - 15px;
        width: 7px;
        height: 4px;
        stroke: root.enabled ? Theme.arrow : Theme.disabled-text;
        stroke-width: 1px;
        viewbox-width: 7;
        viewbox-height: 4;
        commands: "M 0 0 L 3.5 3.5 L 7 0";
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            popup.show();
        }
    }

    // Zero width, so a click reaches the touch area instead of taking the focus first
    focus := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.select(root.current-index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select(root.current-index + 1);
                return accept;
            }
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            reject
        }
    }

    // Shows up to 10 items and scrolls the rest, like Qt
    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: min(root.model.length, 10) * 22px + 2px;

        Rectangle {
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.outline;

            ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;

                for item[index] in root.model: Rectangle {
                    height: 22px;
                    background: item-touch.has-hover ? Theme.item-hover : transparent;

                    Text {
                        x: 5px;
                        width: parent.width - 10px;
                        text: item;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    item-touch := TouchArea {
                        clicked => {
                            root.select(index);
                        }
                    }
                }
            }
        }
    }
}

// Tabs above an outlined page, drawn like AutoSplit's Fusion ones: the other tabs are flat, a
// shade darker than the page, and sit lower. The current one is raised, edged with a light line
// and open into the page. The pages are the children, each shown while it's the current one.
export component TabFrame inherits Rectangle {
    in property <[string]> titles;
    in-out property <int> current-index;
    property <length> bar-height: 25px;

    Outline {
        y: root.bar-height - 1px;
        height: parent.height - self.y;
    }

    Rectangle {
        x: 1px;
        y: root.bar-height;
        width: parent.width - 2px;
        height: 1px;
        background: Theme.tab-highlight;
    }

    HorizontalLayout {
        x: 2px;
        y: 0px;
        height: root.bar-height;
        alignment: start;
        // Neighbors share their outline
        spacing: -1px;

        for title[index] in root.titles: tab := Rectangle {
            property <bool> current: index == root.current-index;
            width: label.preferred-width + 24px;

            Rectangle {
                // The current tab reaches over the page's outline and highlight
                y: tab.current ? 0px : 2px;
                height: parent.height - self.y + (tab.current ? 1px : -1px);

                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 1px;
                    background: tab.current ? Palette.background : Theme.tab;
                }

                for edge in [
                    { x: 2px, y: 0px, w: parent.width - 4px, h: 1px },
                    { x: 0px, y: 2px, w: 1px, h: parent.height - 2px },
                    { x: parent.width - 1px, y: 2px, w: 1px, h: parent.height - 2px },
                    { x: 1px, y: 1px, w: 1px, h: 1px },
                    { x: parent.width - 2px, y: 1px, w: 1px, h: 1px },
                ]: Rectangle {
                    x: edge.x;
                    y: edge.y;
                    width: edge.w;
                    height: edge.h;
                    background: Theme.outline;
                }

                for edge in [
                    { x: 2px, y: 1px, w: parent.width - 4px, h: 1px },
                    { x: 1px, y: 2px, w: 1px, h: parent.height - 2px },
                    { x: parent.width - 2px, y: 2px, w: 1px, h: parent.height - 2px },
                ]: Rectangle {
                    x: edge.x;
                    y: edge.y;
                    width: edge.w;
                    height: edge.h;
                    background: Theme.tab-highlight;
                    visible: tab.current;
                }
            }

            label := Text {
                y: tab.current ? 0px : 1px;
                width: parent.width;
                height: parent.height;
                text: title;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.current-index = index;
                }
            }
        }
    }

    Rectangle {
        x: 1px;
        y: root.bar-height;
        width: parent.width - 2px;
        height: parent.height - self.y - 1px;

        @children
    }
}

// The frame of a text field.
component FieldFrame inherits Rectangle {
    in property <bool> focused;
    in property <bool> enabled: true;
    opacity: enabled ? 1 : 0.6;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: Theme.field;
    }

    Outline {
        width: 100%;
        height: 100%;
        line: root.focused ? Theme.focus : Theme.outline;
    }
}

// A one-line text field.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    in property <bool> read-only;
    in property <string> placeholder-text;
    // What's in it has to change, shown with a red frame
    in property <bool> error;
    // In the monospace font, like a hex color
    in property <bool> monospace;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;

    FieldFrame {
        width: 100%;
        height: 100%;
        focused: input.has-focus;
        enabled: root.enabled;
    }

    if root.error: Rectangle {
        border-width: 1px;
        border-color: Theme.error;
    }

    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        clip: true;

        // A text that's too long shows its end, like Qt's read-only fields do
        input := TextInput {
            x: root.read-only && !self.has-focus ? min(0px, parent.width - self.preferred-width) : 0px;
            width: max(parent.width, self.preferred-width);
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            font-family: root.monospace ? Fonts.mono : Fonts.sans;
            read-only: root.read-only || !root.enabled;
            enabled: root.enabled;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            selection-background-color: Theme.selection;
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }

        Text {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            text: root.placeholder-text;
            color: Theme.disabled-text;
            // Until something is typed, even with the focus, like Qt's
            visible: input.text == "";
            overflow: elide;
        }
    }
}

// A text box of several lines, drawn like TextField. The text wraps, and when it's taller than
// the box, it scrolls to keep the cursor in view.
export component TextArea inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    in property <string> placeholder-text;
    callback edited(string);
    forward-focus: input;
    // A line's height, to keep the cursor's whole line in view
    property <length> line-height: 18px;

    FieldFrame {
        width: 100%;
        height: 100%;
        focused: input.has-focus;
        enabled: root.enabled;
    }

    flick := Flickable {
        x: 4px;
        y: 3px;
        width: parent.width - 8px;
        height: parent.height - 6px;
        content-width: self.width;
        content-height: max(self.height, input.preferred-height);

        input := TextInput {
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            read-only: !root.enabled;
            enabled: root.enabled;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            selection-background-color: Theme.selection;
            edited => {
                root.edited(self.text);
            }
            cursor-position-changed(position) => {
                if (position.y + flick.content-y < 0) {
                    flick.content-y = -position.y;
                }
                if (position.y + root.line-height + flick.content-y > flick.height) {
                    flick.content-y = flick.height - position.y - root.line-height;
                }
            }
        }
    }

    Text {
        x: 4px;
        y: 3px;
        width: parent.width - 8px;
        height: parent.height - 6px;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
        text: root.placeholder-text;
        color: Theme.disabled-text;
        // Until something is typed, even with the focus, like Qt's
        visible: input.text == "";
    }
}

// A spin box: a number field with up and down arrows, like Qt's. The value is corrected into
// the range when editing ends. Arrows repeat while held, and the mouse wheel and PageUp and
// PageDown step too.
export component SpinBox inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <bool> enabled: true;
    // Off: typing only reports on Enter or leaving the field, for values that are costly to apply
    in property <bool> live: true;
    // Changes when the field is filled with another thing's value, like another split's: what was
    // typed before is dropped instead of reported for it
    in property <int> generation;
    callback edited(float);
    forward-focus: input;
    // The arrow held down: 1 up, -1 down, 0 none
    property <int> holding;
    // Something was typed since the value was last shown, while generation was typed-at
    property <bool> typed;
    property <int> typed-at;

    function shown(number: float) -> string {
        return root.decimals == 0 ? round(number) : number.to-fixed(root.decimals);
    }

    // Sets a value, corrected into the range, and reports it when it changed
    function set(number: float) {
        let corrected = max(root.minimum, min(root.maximum, number));
        root.typed = false;
        input.text = root.shown(corrected);
        if (corrected != root.value) {
            root.value = corrected;
            root.edited(root.value);
        }
    }

    // Only what was typed is reported: the shown text is rounded, and reporting it would change a
    // value that's only been looked at
    function commit() {
        if (root.typed && root.typed-at == root.generation && input.text.is-float()) {
            root.set(input.text.to-float());
        } else {
            root.typed = false;
            input.text = root.shown(root.value);
        }
    }

    changed generation => {
        root.typed = false;
        input.text = root.shown(root.value);
    }

    // Typing replaces the binding to value, so changes from elsewhere are shown by hand
    changed value => {
        if (!input.has-focus) {
            input.text = root.shown(root.value);
        }
    }

    FieldFrame {
        width: 100%;
        height: 100%;
        focused: input.has-focus;
        enabled: root.enabled;
    }

    TouchArea {
        enabled: root.enabled;
        scroll-event(event) => {
            if (event.delta-y > 0) {
                root.set(root.value + root.step);
            } else if (event.delta-y < 0) {
                root.set(root.value - root.step);
            }
            accept
        }
    }

    Rectangle {
        x: 4px;
        width: parent.width - 20px;
        clip: true;

        input := TextInput {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            input-type: root.decimals == 0 ? InputType.number : InputType.decimal;
            enabled: root.enabled;
            read-only: !root.enabled;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            selection-background-color: Theme.selection;
            text: root.shown(root.value);
            edited => {
                root.typed = true;
                root.typed-at = root.generation;
                if (root.live && self.text.is-float() && self.text.to-float() >= root.minimum && self.text.to-float() <= root.maximum && self.text.to-float() != root.value) {
                    root.value = self.text.to-float();
                    root.edited(root.value);
                }
            }
            accepted => {
                root.commit();
            }
            changed has-focus => {
                if (!self.has-focus && WindowFocus.active) {
                    root.commit();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.set(root.value + root.step);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.set(root.value - root.step);
                    return accept;
                }
                if (event.text == Key.PageUp) {
                    root.set(root.value + 10 * root.step);
                    return accept;
                }
                if (event.text == Key.PageDown) {
                    root.set(root.value - 10 * root.step);
                    return accept;
                }
                reject
            }
        }
    }

    // Qt repeats a held arrow after a moment
    repeat := Timer {
        interval: 350ms;
        running: root.holding != 0;
        triggered => {
            self.interval = 60ms;
            root.set(root.value + root.holding * root.step);
            // The arrow is disabled at the end of the range, so its release never comes
            if ((root.holding > 0 && root.value >= root.maximum) || (root.holding < 0 && root.value <= root.minimum)) {
                root.holding = 0;
            }
        }
    }

    // Inside the field's frame, which goes around them too, so it stays whole when it's
    // focused instead of showing through the arrows' rounded corners
    for arrow[index] in [{ up: true }, { up: false }]: Rectangle {
        x: parent.width - 16px;
        y: index == 0 ? 1px : parent.height / 2;
        width: 15px;
        height: parent.height / 2 - 1px;
        // Greyed at the end of the range, like Qt's
        property <bool> usable: root.enabled && (arrow.up ? root.value < root.maximum : root.value > root.minimum);

        Face {
            width: 100%;
            height: 100%;
            pressed: arrow-touch.pressed && parent.usable;
            hovered: arrow-touch.has-hover && parent.usable;
        }

        Path {
            width: 7px;
            height: 4px;
            stroke: parent.usable ? Theme.arrow : Theme.disabled-text;
            stroke-width: 1px;
            viewbox-width: 7;
            viewbox-height: 4;
            commands: arrow.up ? "M 0 4 L 3.5 0.5 L 7 4" : "M 0 0 L 3.5 3.5 L 7 0";
        }

        arrow-touch := TouchArea {
            enabled: parent.usable;
            // Steps on press, like Qt, then repeats while held
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.set(root.value + (arrow.up ? root.step : -root.step));
                    repeat.interval = 350ms;
                    root.holding = arrow.up ? 1 : -1;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.holding = 0;
                }
            }
        }
    }
}

// A part of a split image's file name, as the split image loader reads it. `kind` is what it does:
// Text, Number, Keyword, Threshold, Pause, Delay, Loops, Method, Flags, Fade time or Extension.
// What a part of a split image's file name is, like the parser's PartKind.
export enum NameKind { text, number, keyword, threshold, pause, delay, loops, method, flags, fade-time, extension }

export struct NamePart {
    text: string,
    kind: NameKind,
    meaning: string,
    ignored: bool,
}

// The colors of the file name's parts, so each kind of value stands out.
export global NameColors {
    public pure function of(part: NamePart) -> color {
        if part.ignored {
            return Theme.warning;
        }
        if part.kind == NameKind.number || part.kind == NameKind.extension {
            return Theme.secondary-text;
        }
        if part.kind == NameKind.keyword {
            return Theme.dark ? #f1948a : #b03a2e;
        }
        if part.kind == NameKind.threshold {
            return Theme.reached;
        }
        if part.kind == NameKind.pause {
            return Theme.meter;
        }
        if part.kind == NameKind.delay {
            return Theme.dark ? #4dd0e1 : #00838f;
        }
        if part.kind == NameKind.loops {
            return Theme.dark ? #9fa8da : #283593;
        }
        if part.kind == NameKind.method {
            return Theme.dark ? #f48fb1 : #c2185b;
        }
        if part.kind == NameKind.flags {
            return Theme.dark ? #c39bd3 : #8e44ad;
        }
        // Brown, which no other part has: told apart from the others with red-green color
        // blindness too, and readable on the window in both themes
        if part.kind == NameKind.fade-time {
            return Theme.dark ? #e3c4b5 : #5c3623;
        }
        return Theme.text;
    }
}

// A split image's file name, each part colored by what it does, with what it does on hover.
// Without parts, `file` is shown plainly.
export component FileName inherits HorizontalLayout {
    in property <[NamePart]> parts;
    in property <string> file;
    // Shown on hover over the plain parts
    in property <string> path;
    alignment: start;

    if root.parts.length == 0: Label {
        font-family: Fonts.mono;
        text: root.file;
    }

    for part in root.parts: Rectangle {
        width: text.preferred-width;

        text := Text {
            vertical-alignment: center;
            font-family: Fonts.mono;
            text: part.text;
            font-weight: part.kind == NameKind.text ? 400 : 600;
            color: NameColors.of(part);
        }

        // None for a plain part where there's no path to show, like the split's name
        if part.meaning != "" || root.path != "": Tooltip {
            Tip {
                text: part.meaning != "" ? part.meaning : root.path;
            }
        }
    }
}

// Something was saved: a green tint from the left edge that fades out across it, then fades away
// when `shown` turns off.
export component SavedGlow inherits Rectangle {
    in property <bool> shown;
    width: 100%;
    height: 100%;
    background: @linear-gradient(90deg, Theme.reached.with-alpha(0.4) 0%, Theme.reached.with-alpha(0) 100%);
    opacity: 0;

    states [
        saved when root.shown: {
            opacity: 1;
            out {
                animate opacity { duration: 700ms; easing: ease-out; }
            }
        }
    ]
}

// Something was saved: what's under it dims behind a green check mark that pops in, then both fade
// out when `shown` turns off. `size` is the check mark's width.
export component SavedCheck inherits Rectangle {
    in property <bool> shown;
    in property <length> size: 48px;
    property <float> scale: 0.6;
    width: 100%;
    height: 100%;
    background: #000000.with-alpha(0.45);
    opacity: 0;

    states [
        saved when root.shown: {
            opacity: 1;
            scale: 1;
            in {
                animate scale { duration: 250ms; easing: ease-out-back; }
            }
            out {
                animate opacity, scale { duration: 300ms; easing: ease-out; }
            }
        }
    ]

    // A dark green edge under the bright stroke, so it stands out on light and dark pictures
    for stroke in [
        { color: #0b3d1a, width: 0.2 },
        { color: #5be37f, width: 0.12 },
    ]: Path {
        width: root.size * root.scale;
        height: root.size * root.scale * 0.8;
        viewbox-width: 40;
        viewbox-height: 32;
        commands: "M 6 17 L 15 26 L 34 6";
        stroke: stroke.color;
        stroke-width: root.size * root.scale * stroke.width;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
